from typing import List, Optional
from src.schema import (
    SchemaModel,
    StrField, IntField, FloatField, BoolField, StrListField, ItemsField, ModelField, Field,
    ValidationError
)

class AddressSchema(SchemaModel):
    city: str = StrField(min_length=2, max_length=50)
    detail: str = StrField(min_length=5, max_length=120, strip_whitespace=True)
    zip_code: str = StrField(alias="zipCode", pattern=r"^[0-9]{6}$")

class FulfillmentItemSchema(SchemaModel):
    sku_id: str = StrField(min_length=3, max_length=32, pattern=r"^[A-Z0-9_-]+$")
    quantity: int = IntField(default=1, ge=1, le=100)
    unit_price: float = FloatField(default=0.01, ge=0.01, le=50000.0, alias="unitPrice")

class FulfillmentRequest(SchemaModel):
    tracking_sn: str = StrField(pattern=r"^SF-[0-9]{8}$")
    customer_email: str = StrField(format="email")
    delivery_speed: str = StrField(default="standard", choices=["standard", "express", "same_day"], alias="deliverySpeed")
    priority: int = IntField(default=1, gt=0, lt=10)
    fragile: bool = BoolField(default=False)
    insured_amount: float = FloatField(default=0.0, ge=0.0, le=20000.0)
    memo: Optional[str] = None
    discount_code: Optional[str] = None
    tags: List[str] = StrListField(min_items=1, max_items=5)
    address: AddressSchema = ModelField(AddressSchema())
    items: List[FulfillmentItemSchema] = ItemsField(FulfillmentItemSchema(), min_items=1, max_items=10)

    def custom_validate(self) -> List[ValidationError]:
        errs = List[ValidationError]()
        if self.delivery_speed == "same_day":
            valid_cities = ["Shanghai", "Beijing", "Shenzhen", "Hangzhou"]
            city_ok = False
            for c in valid_cities:
                if self.address.city == c:
                    city_ok = True
                    break
            if not city_ok:
                errs.append(ValidationError("delivery_speed", "Same-day delivery only in tier 1", "value_error.unsupported_region", loc=["body", "deliverySpeed"]))
        if self.fragile:
            total_qty = 0
            for item in self.items:
                total_qty += item.quantity
            if total_qty > 20:
                errs.append(ValidationError("items", "Fragile limit", "value_error.fragile_item_limit", loc=["body", "items"]))
        if self.delivery_speed in ("express", "same_day"):
            if len(self.address.detail.strip()) < 10:
                errs.append(ValidationError("detail", "Detail len", "value_error.address_detail_insufficient", loc=["body", "address", "detail"]))
        return errs

class FulfillmentOrderUpdateSchema(SchemaModel):
    delivery_speed: str = StrField(default="standard", choices=["standard", "express", "same_day"], alias="deliverySpeed")
    priority: int = IntField(default=1, gt=0, lt=10)
    memo: Optional[str] = None
    insured_amount: float = FloatField(default=0.0, ge=0.0, le=20000.0)
    status_code: int = IntField(default=1, ge=0, le=10)

class WarehouseInventorySchema(SchemaModel):
    sku_id: str = StrField(min_length=3, max_length=32, pattern=r"^[A-Z0-9_-]+$")
    warehouse_code: str = StrField(choices=["WH-EAST-01", "WH-NORTH-02", "WH-SOUTH-03"])
    zone_id: int = IntField(default=1, ge=1, le=999)
    total_stock: int = IntField(default=100, ge=0, le=1000000)
    reserved_stock: int = IntField(default=0, ge=0, le=1000000)
    unit_weight_kg: float = FloatField(default=1.0, ge=0.01, le=500.0)
    temperature_controlled: bool = BoolField(default=False)
    target_temperature: Optional[float] = None
    min_reorder_level: Optional[int] = None
    is_quarantine: Optional[bool] = None
    dimensions_cm: List[int] = ItemsField(0, min_items=3, max_items=3)
    inspection_flags: List[bool] = ItemsField(False, min_items=2, max_items=5)

    def custom_validate(self) -> List[ValidationError]:
        errs = List[ValidationError]()
        if self.total_stock < self.reserved_stock:
            errs.append(ValidationError("total_stock", "Total stock cannot be less than reserved stock", "value_error.stock_inconsistent", loc=["body", "total_stock"]))
        if self.temperature_controlled and self.target_temperature is None:
            errs.append(ValidationError("target_temperature", "Temperature-controlled items must specify target temperature", "value_error.missing_target_temp", loc=["body", "target_temperature"]))
        return errs

class InventoryUpdateSchema(SchemaModel):
    total_stock: int = IntField(default=0, ge=0, le=1000000)
    reserved_stock: int = IntField(default=0, ge=0, le=1000000)
    min_reorder_level: Optional[int] = None
    is_quarantine: Optional[bool] = None

    def custom_validate(self) -> List[ValidationError]:
        errs = List[ValidationError]()
        if self.total_stock < self.reserved_stock:
            errs.append(ValidationError("total_stock", "Total stock cannot be less than reserved stock", "value_error.stock_inconsistent", loc=["body", "total_stock"]))
        return errs

class LogisticsRoutePointSchema(SchemaModel):
    station_name: str = StrField(min_length=2, max_length=50)
    city: str = StrField(min_length=2, max_length=50)
    passed: bool = BoolField(default=True)

class ShipmentTrackingSchema(SchemaModel):
    waybill_no: str = StrField(pattern=r"^WB-[A-Z0-9]{10}$")
    carrier_code: str = StrField(choices=["SF_EXPRESS", "JD_LOGISTICS", "EMS_GLOBAL"])
    status_code: int = IntField(default=0, ge=0, le=10)
    dispatcher_email: str = StrField(format="email")
    gross_weight_kg: float = FloatField(default=1.0, ge=0.01, le=1000.0)
    signature_required: Optional[bool] = None
    delivery_deadline_hours: Optional[int] = None
    carbon_footprint_kg: Optional[float] = None
    gps_coordinates: List[float] = ItemsField(0.0, min_items=2, max_items=2)
    route_stations: List[LogisticsRoutePointSchema] = ItemsField(LogisticsRoutePointSchema(), min_items=1, max_items=5)

    def custom_validate(self) -> List[ValidationError]:
        errs = List[ValidationError]()
        if self.carrier_code == "SF_EXPRESS" and self.gross_weight_kg > 500.0:
            errs.append(ValidationError("gross_weight_kg", "SF Express single waybill cannot exceed 500kg", "value_error.overweight_sf", loc=["body", "gross_weight_kg"]))
        if len(self.gps_coordinates) == 2:
            lat = self.gps_coordinates[0]
            lng = self.gps_coordinates[1]
            if lat < -90.0 or lat > 90.0:
                errs.append(ValidationError("gps_coordinates", "Latitude must be between -90 and 90", "value_error.latitude", loc=["body", "gps_coordinates", "0"]))
            if lng < -180.0 or lng > 180.0:
                errs.append(ValidationError("gps_coordinates", "Longitude must be between -180 and 180", "value_error.longitude", loc=["body", "gps_coordinates", "1"]))
        return errs

class ShipmentUpdateSchema(SchemaModel):
    status_code: int = IntField(default=0, ge=0, le=10)
    status_remark: str = StrField(min_length=1, max_length=200)
    carbon_footprint_kg: Optional[float] = None



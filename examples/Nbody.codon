import math
import time
from simd import Vec


@extend
class Vec:
    @pure
    @llvm
    def __new__(a: float, b: float, c: float, d: float) -> Vec[float, 4]:
        %0 = insertelement <4 x double> undef, double %a, i32 0
        %1 = insertelement <4 x double> %0, double %b, i32 1
        %2 = insertelement <4 x double> %1, double %c, i32 2
        %3 = insertelement <4 x double> %2, double %d, i32 3
        ret <4 x double> %3

    def __mul__(self: Vec[float, 4], other: float) -> Vec[float, 4]:
        return self * Vec[float, 4](other)

@extend
class Ptr:
    @self_captures
    @llvm
    def __setitem__(self: Ptr[Vec[float, 4]], index: int, what: Vec[float, 4]) -> None:
        %0 = getelementptr <4 x double>, ptr %self, i64 %index
        store <4 x double> %what, ptr %0, align 8
        ret {} {}

    @pure
    @derives
    @llvm
    def __getitem__(self: Ptr[Vec[float, 4]], index: int) -> Vec[float, 4]:
        %0 = getelementptr <4 x double>, ptr %self, i64 %index
        %1 = load <4 x double>, ptr %0, align 8
        ret <4 x double> %1


PI = 3.141592653589793
SOLAR_MASS = 4.0 * PI * PI
DAYS_PER_YEAR = 365.24

NUM_BODIES = 5
DT = 0.01

Vec4 = Vec[float, 4]


class NBodySystem:
    def __init__(self):
        self.pos = [
            Vec4(0.0),
            Vec4(4.84143144246472090e+00, -1.16032004402742839e+00, -1.03622044471123109e-01, 0.0),
            Vec4(8.34336671824458000e+00, 4.12479856412430479e+00, -4.03523417114321381e-01, 0.0),
            Vec4(1.28943695621391310e+01, -1.51111514016986312e+01, -2.23307578892655734e-01, 0.0),
            Vec4(1.53796971148509165e+01, -2.59193146099879641e+01, 1.79258772950371181e-01, 0.0),
        ]

        self.vel = [
            Vec4(0.0),
            Vec4(1.66007664274403694e-03 * DAYS_PER_YEAR, 7.69901118419740425e-03 * DAYS_PER_YEAR, -6.90460016972063023e-05 * DAYS_PER_YEAR, 0.0),
            Vec4(-2.76742510726862411e-03 * DAYS_PER_YEAR, 4.99852801234917238e-03 * DAYS_PER_YEAR, 2.30417297573763929e-05 * DAYS_PER_YEAR, 0.0),
            Vec4(2.96460137564761618e-03 * DAYS_PER_YEAR, 2.37847173959480950e-03 * DAYS_PER_YEAR, -2.96589568540237556e-05 * DAYS_PER_YEAR, 0.0),
            Vec4(2.68067772490389322e-03 * DAYS_PER_YEAR, 1.62824170038242295e-03 * DAYS_PER_YEAR, -9.51592254519715870e-05 * DAYS_PER_YEAR, 0.0),
        ]

        self.mass = [
            SOLAR_MASS,
            9.54791938424326609e-04 * SOLAR_MASS,
            2.858856406e-04 * SOLAR_MASS,
            4.366244038e-05 * SOLAR_MASS,
            5.151389020e-05 * SOLAR_MASS,
        ]

    def offset_momentum(self):
        px = 0.0
        py = 0.0
        pz = 0.0

        for i in range(NUM_BODIES):
            px += self.vel[i][0] * self.mass[i]
            py += self.vel[i][1] * self.mass[i]
            pz += self.vel[i][2] * self.mass[i]

        self.vel[0] = Vec4(
            -px / self.mass[0],
            -py / self.mass[0],
            -pz / self.mass[0],
            0.0,
        )

    def advance(self, n: int):
        for _ in range(n):
            for i in range(NUM_BODIES):
                for j in range(i + 1, NUM_BODIES):
                    dp = self.pos[i] - self.pos[j]

                    dsq = (dp * dp).sum()
                    mag = DT / (dsq * math.sqrt(dsq))

                    mi = self.mass[i] * mag
                    mj = self.mass[j] * mag

                    self.vel[i] -= dp * mj
                    self.vel[j] += dp * mi

            for i in range(NUM_BODIES):
                self.pos[i] += self.vel[i] * DT

    def energy(self) -> float:
        e = 0.0

        for i in range(NUM_BODIES):
            v2 = (self.vel[i] * self.vel[i]).sum()

            e += 0.5 * self.mass[i] * v2

            for j in range(i + 1, NUM_BODIES):
                dp = self.pos[i] - self.pos[j]
                distance = math.sqrt((dp * dp).sum())

                e -= (self.mass[i] * self.mass[j]) / distance

        return e


def run_nbody(n: int = 500_000):
    system = NBodySystem()

    system.offset_momentum()

    # t0 = time()

    system.advance(n)

    # t1 = time()

    system.energy()
    # print("Time  :", t1 - t0, "seconds")


t0 = time.time()
run_nbody()
t1 = time.time()
print("Time  :", t1 - t0, "seconds")
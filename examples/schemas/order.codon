# E-commerce Order Submission Schema
from src.schema import SchemaModel, StrField, IntField, FloatField, BoolField, ValidationError

class OrderCreate(SchemaModel):
    """E-commerce order submission schema with price and quantity verification."""
    order_sn: str = StrField(min_length=8, max_length=64, description="Unique merchant order serial number")
    quantity: int = IntField(ge=1, le=999, default=1, description="Purchase item quantity")
    amount: float = FloatField(ge=0.01, le=100000.0, description="Total order payment amount")
    pay_method: str = StrField(choices=["alipay", "wechat", "credit_card"], default="alipay", description="Payment gateway")
    need_invoice: bool = BoolField(default=False, description="Whether invoice is required")

    def custom_validate(self) -> List[ValidationError]:
        """Cross-field risk control domain rule."""
        errs = List[ValidationError]()
        if self.pay_method == "credit_card" and self.amount < 50.0:
            errs.append(ValidationError("amount", "Credit card payment requires minimum order amount of 50.00", "value_error.risk"))
        return errs



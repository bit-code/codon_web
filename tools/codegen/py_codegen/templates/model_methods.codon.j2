            return ValidationResult[{{ cls.name }}](None, _custom_errs)
{% endif %}
        return ValidationResult.ok(_inst)

    def copy_to[T](self, target: T) -> None:
        """Zero-alloc direct attribute transfer to target entity (no intermediate Dict)."""
{% for f in cls.fields %}
{% if f.is_optional %}
        if self.{{ f.name }} is not None:
            target["{{ f.name }}"] = self.{{ f.name }}
{% elif f.is_list %}
{% if f.is_submodel %}
        _sub_items_{{ f.name }} = List[str]()
        for _x in self.{{ f.name }}:
            _sub_items_{{ f.name }}.append(_x.to_json())
        target["{{ f.name }}"] = "[" + ",".join(_sub_items_{{ f.name }}) + "]"
{% elif f.list_item_type == "bool" %}
        _items_{{ f.name }} = List[str]()
        for _x in self.{{ f.name }}:
            _items_{{ f.name }}.append("1" if _x else "0")
        target["{{ f.name }}"] = ",".join(_items_{{ f.name }})
{% elif f.list_item_type == "int" or f.list_item_type == "float" %}
        _items_{{ f.name }} = List[str]()
        for _x in self.{{ f.name }}:
            _items_{{ f.name }}.append(str(_x))
        target["{{ f.name }}"] = ",".join(_items_{{ f.name }})
{% else %}
        target["{{ f.name }}"] = ",".join(self.{{ f.name }})
{% endif %}
{% elif f.is_submodel %}
        self.{{ f.name }}.copy_to(target)
{% else %}
        target["{{ f.name }}"] = self.{{ f.name }}
{% endif %}
{% endfor %}

    @staticmethod
    def openapi_schema_json() -> str:
        return '{{ openapi_schemas[cls.name] }}'

    @staticmethod
    def model_json_schema() -> str:
        return {{ cls.name }}.openapi_schema_json()

{% endfor %}

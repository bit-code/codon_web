from src.os.constants import (
    EPOLLIN, EPOLLOUT, EPOLLERR, EPOLLHUP, EPOLLRDHUP, EPOLLET,
    EPOLL_CTL_ADD, EPOLL_CTL_MOD, EPOLL_CTL_DEL, EINTR
)
from src.os.linux import (
    epoll_create1 as c_epoll_create1,
    epoll_ctl as c_epoll_ctl,
    epoll_wait as c_epoll_wait,
    close as c_close,
    get_errno,
    get_error_message
)

# On Linux x86_64, struct epoll_event is strictly 12 bytes packed:
# offset 0..3:  u32 events
# offset 4..11: u64 data (union containing void* ptr / i32 fd / u32 / u64)
# sizeof(struct epoll_event) == 12

@tuple
class EpollEvent:
    events: u32
    fd: i32

class Epoll:
    epfd: i32
    max_events: int
    raw_event_buf: Ptr[byte]
    events_list: list[EpollEvent]
    is_closed: bool

    def __init__(self, max_events: int = 1024):
        epfd = c_epoll_create1(i32(0))
        if epfd < i32(0):
            err = get_errno()
            raise OSError("epoll_create1 failed: " + get_error_message(err))
        self.epfd = epfd
        self.max_events = max_events if max_events > 0 else 1024
        # 12 bytes per event * max_events
        self.raw_event_buf = Ptr[byte](self.max_events * 12)
        self.events_list = []
        self.is_closed = False

    @property
    def fd(self) -> i32:
        return self.epfd

    def add(self, fd: i32, events: u32) -> None:
        ev_buf = Ptr[byte](12)
        # pack events
        ev_buf[0] = byte(events & u32(0xFF))
        ev_buf[1] = byte((events >> u32(8)) & u32(0xFF))
        ev_buf[2] = byte((events >> u32(16)) & u32(0xFF))
        ev_buf[3] = byte((events >> u32(24)) & u32(0xFF))
        # pack fd
        ufd = u32(fd)
        ev_buf[4] = byte(ufd & u32(0xFF))
        ev_buf[5] = byte((ufd >> u32(8)) & u32(0xFF))
        ev_buf[6] = byte((ufd >> u32(16)) & u32(0xFF))
        ev_buf[7] = byte((ufd >> u32(24)) & u32(0xFF))
        # pad 8..11 with 0
        ev_buf[8] = byte(0)
        ev_buf[9] = byte(0)
        ev_buf[10] = byte(0)
        ev_buf[11] = byte(0)

        ret = c_epoll_ctl(self.epfd, EPOLL_CTL_ADD, fd, ev_buf)
        if ret < i32(0):
            err = get_errno()
            raise OSError("epoll_ctl ADD failed for fd " + str(fd) + ": " + get_error_message(err))

    def modify(self, fd: i32, events: u32) -> None:
        ev_buf = Ptr[byte](12)
        ev_buf[0] = byte(events & u32(0xFF))
        ev_buf[1] = byte((events >> u32(8)) & u32(0xFF))
        ev_buf[2] = byte((events >> u32(16)) & u32(0xFF))
        ev_buf[3] = byte((events >> u32(24)) & u32(0xFF))
        ufd = u32(fd)
        ev_buf[4] = byte(ufd & u32(0xFF))
        ev_buf[5] = byte((ufd >> u32(8)) & u32(0xFF))
        ev_buf[6] = byte((ufd >> u32(16)) & u32(0xFF))
        ev_buf[7] = byte((ufd >> u32(24)) & u32(0xFF))
        ev_buf[8] = byte(0)
        ev_buf[9] = byte(0)
        ev_buf[10] = byte(0)
        ev_buf[11] = byte(0)

        ret = c_epoll_ctl(self.epfd, EPOLL_CTL_MOD, fd, ev_buf)
        if ret < i32(0):
            err = get_errno()
            raise OSError("epoll_ctl MOD failed for fd " + str(fd) + ": " + get_error_message(err))

    def remove(self, fd: i32) -> None:
        # In Linux 2.6.9+, event pointer can be NULL for EPOLL_CTL_DEL
        ret = c_epoll_ctl(self.epfd, EPOLL_CTL_DEL, fd, Ptr[byte](0))
        if ret < i32(0):
            err = get_errno()
            # Ignore ENOENT if already removed
            if err != i32(2): # ENOENT
                raise OSError("epoll_ctl DEL failed for fd " + str(fd) + ": " + get_error_message(err))

    def wait_raw(self, timeout_ms: int = -1) -> int:
        num_events = c_epoll_wait(self.epfd, self.raw_event_buf, i32(self.max_events), i32(timeout_ms))
        if num_events < i32(0):
            err = get_errno()
            if err == EINTR:
                return 0
            raise OSError("epoll_wait failed: " + get_error_message(err))
        return int(num_events)

    def get_event(self, idx: int) -> u32:
        base = idx * 12
        p_ev = Ptr[u32]((self.raw_event_buf + base).as_byte())
        return p_ev[0]

    def get_fd(self, idx: int) -> i32:
        base = idx * 12
        p_fd = Ptr[i32]((self.raw_event_buf + base + 4).as_byte())
        return p_fd[0]

    def wait(self, timeout_ms: int = -1) -> list[EpollEvent]:
        num_events = c_epoll_wait(self.epfd, self.raw_event_buf, i32(self.max_events), i32(timeout_ms))
        if num_events < i32(0):
            err = get_errno()
            if err == EINTR:
                return []
            raise OSError("epoll_wait failed: " + get_error_message(err))

        count = int(num_events)
        self.events_list.clear()
        for i in range(count):
            base = i * 12
            p_ev = Ptr[u32]((self.raw_event_buf + base).as_byte())
            p_fd = Ptr[i32]((self.raw_event_buf + base + 4).as_byte())
            self.events_list.append(EpollEvent(p_ev[0], p_fd[0]))
        return self.events_list

    def close(self) -> None:
        if not self.is_closed and self.epfd >= i32(0):
            c_close(self.epfd)
            self.is_closed = True
            self.epfd = i32(-1)

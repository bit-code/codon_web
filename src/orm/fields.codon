class DecimalField(Field):
    precision: int
    scale: int

    def __init__(
        self,
        name: str = "",
        precision: int = 10,
        scale: int = 2,
        nullable: bool = True,
        default_val: str = "0.00",
        db_column: str = "",
        comment: str = ""
    ):
        super().__init__(
            name=name,
            field_type="decimal",
            max_length=precision,
            primary_key=False,
            auto_increment=False,
            nullable=nullable,
            default_val=default_val,
            unique=False,
            index=False,
            db_column=db_column,
            comment=comment
        )
        self.precision = precision
        self.scale = scale



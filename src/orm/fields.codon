from typing import Optional, List
from src.orm.sql.column import Column
from src.db.types import (
    FieldInfo, COL_KIND_INT, COL_KIND_FLOAT, COL_KIND_BOOL, COL_KIND_STR, COL_KIND_RAW_JSON
)

class Field:
    name: str
    field_type: str
    max_length: int
    primary_key: bool
    auto_increment: bool
    nullable: bool
    default_val: str
    unique: bool
    index: bool
    db_column: str
    comment: str

    def __init__(
        self,
        name: str = "",
        field_type: str = "varchar",
        max_length: int = 255,
        primary_key: bool = False,
        auto_increment: bool = False,
        nullable: bool = True,
        default_val: str = "",
        unique: bool = False,
        index: bool = False,
        db_column: str = "",
        comment: str = ""
    ):
        self.name = name
        self.field_type = field_type
        self.max_length = max_length
        self.primary_key = primary_key
        self.auto_increment = auto_increment
        self.nullable = nullable
        self.default_val = default_val
        self.unique = unique
        self.index = index
        self.db_column = db_column if len(db_column) > 0 else name
        self.comment = comment

    def get_column_name(self) -> str:
        return self.db_column if len(self.db_column) > 0 else self.name

    def to_column(self) -> Column:
        return Column(name=self.get_column_name(), data_type=self.field_type)

    def get_kind(self) -> int:
        ft = self.field_type.lower()
        if ft == "int" or ft == "integer" or ft == "bigint" or ft == "smallint" or ft == "tinyint" or ft == "mediumint" or ft == "year":
            return COL_KIND_INT
        if ft == "float" or ft == "double" or ft == "decimal" or ft == "numeric" or ft == "real":
            return COL_KIND_FLOAT
        if ft == "bool" or ft == "boolean":
            return COL_KIND_BOOL
        if ft == "json":
            return COL_KIND_RAW_JSON
        return COL_KIND_STR

    def to_field_info(self) -> FieldInfo:
        return FieldInfo(name=self.get_column_name(), kind=self.get_kind())


class IntegerField(Field):
    def __init__(
        self,
        name: str = "",
        primary_key: bool = False,
        auto_increment: bool = False,
        nullable: bool = True,
        default_val: str = "",
        unique: bool = False,
        index: bool = False,
        db_column: str = "",
        comment: str = ""
    ):
        super().__init__(
            name=name,
            field_type="int",
            primary_key=primary_key,
            auto_increment=auto_increment,
            nullable=nullable,
            default_val=default_val,
            unique=unique,
            index=index,
            db_column=db_column,
            comment=comment
        )



from typing import Callable
from src.http.request import Request
from src.http.response import Response
from src.runtime.event_loop import RequestHandler

# Base Handler interface inheriting from runtime RequestHandler
class RouteHandler(RequestHandler):
    def handle(self, req: Request) -> Response:
        return Response.text("Not Found", 404)

# Function pointer wrapper for standard handler fn(Request) -> Response
class SimpleHandler(RouteHandler):
    fn: Callable[[Request], Response]

    def __init__(self, fn: Callable[[Request], Response]):
        self.fn = fn

    def handle(self, req: Request) -> Response:
        return self.fn(req)

# Dependency injection wrapper that executes pre-handler dependencies
class DependencyRouteHandler(RouteHandler):
    dependencies: list[Callable[[Request], None]]
    inner_handler: RouteHandler

    def __init__(self, inner_handler: RouteHandler):
        self.dependencies = list[Callable[[Request], None]]()
        self.inner_handler = inner_handler

    def __init__(self, dependencies: list[Callable[[Request], None]], inner_handler: RouteHandler):
        self.dependencies = dependencies
        self.inner_handler = inner_handler

    def add_dependency(self, dep: Callable[[Request], None]) -> None:
        self.dependencies.append(dep)

    def handle(self, req: Request) -> Response:
        for i in range(len(self.dependencies)):
            dep = self.dependencies[i]
            dep(req)
        return self.inner_handler.handle(req)

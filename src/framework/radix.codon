from src.http.request import Request
from src.http.response import Response
from src.http.method import HttpMethod
from src.framework.route import RouteHandler
from src.memory.slice import ByteSlice

class RouteNode:
    segment: str
    segment_slice: ByteSlice
    is_param: bool
    param_name: str
    param_type: str # "int", "str"
    is_wildcard: bool
    handlers: dict[i32, RouteHandler]
    children: list[RouteNode]

    def __init__(self, segment: str = ""):
        self.segment = segment
        if len(segment) > 0:
            self.segment_slice = ByteSlice(self.segment.c_str().as_byte(), len(self.segment))
        else:
            self.segment_slice = ByteSlice(Ptr[byte](0), 0)
        self.is_param = False
        self.param_name = ""
        self.param_type = "str"
        self.is_wildcard = False
        self.handlers = {}
        self.children = []

    def find_static_child_slice(self, seg: ByteSlice) -> Optional[RouteNode]:
        for i in range(len(self.children)):
            c = self.children[i]
            if not c.is_param and not c.is_wildcard and c.segment_slice.equals_slice(seg):
                return c
        return None

    def find_static_child(self, seg: str) -> Optional[RouteNode]:
        for i in range(len(self.children)):
            c = self.children[i]
            if not c.is_param and not c.is_wildcard and c.segment == seg:
                return c
        return None

    def find_param_child(self) -> Optional[RouteNode]:
        for i in range(len(self.children)):
            c = self.children[i]
            if c.is_param:
                return c
        return None

    def find_wildcard_child(self) -> Optional[RouteNode]:
        for i in range(len(self.children)):
            c = self.children[i]
            if c.is_wildcard:
                return c
        return None

class RadixRouter:
    root: RouteNode
    not_found_handler: Optional[RouteHandler]
    method_not_allowed_handler: Optional[RouteHandler]
    static_routes: dict[Tuple[i32, str], RouteHandler]
    static_routes_bs: dict[Tuple[i32, ByteSlice], RouteHandler]
    static_route_strings: list[str]
    has_static_routes: bool

    def __init__(self):
        self.root = RouteNode("")
        self.not_found_handler = None
        self.method_not_allowed_handler = None
        self.static_routes = {}
        self.static_routes_bs = {}
        self.static_route_strings = []
        self.has_static_routes = False

    def _is_static_path(self, path: str) -> bool:
        for i in range(len(path)):
            c = path[i]
            if c == '{' or c == '*':
                return False
        return True

    def _split_path(self, path: str) -> list[str]:
        res: list[str] = []
        plen = len(path)
        if plen == 0:
            return res
        start = 0
        while start < plen:
            while start < plen and path[start] == '/':
                start += 1
            if start >= plen:
                break
            end = start
            while end < plen and path[end] != '/':
                end += 1
            res.append(path[start:end])
            start = end
        return res

    def add_route(self, method: i32, path: str, handler: RouteHandler) -> None:
        if self._is_static_path(path):
            norm_path = path
            if not norm_path.startswith("/"):
                norm_path = "/" + norm_path
            if len(norm_path) > 1 and norm_path.endswith("/"):
                norm_path = norm_path[:-1]
            self.static_routes[(method, norm_path)] = handler
            self.static_route_strings.append(norm_path)
            bs_key = ByteSlice(norm_path.c_str().as_byte(), len(norm_path))
            self.static_routes_bs[(method, bs_key)] = handler
            self.has_static_routes = True

        segments = self._split_path(path)
        curr = self.root

        for i in range(len(segments)):
            seg = segments[i]
            if seg.startswith("{") and seg.endswith("}"):
                param_spec = seg[1:-1]
                param_name = param_spec
                param_type = "str"
                
                colon_idx = -1
                for j in range(len(param_spec)):
                    if param_spec[j] == ':':
                        colon_idx = j
                        break
                if colon_idx >= 0:
                    param_name = param_spec[:colon_idx]
                    param_type = param_spec[colon_idx + 1:]

                param_child = curr.find_param_child()
                if param_child is None:
                    node = RouteNode(seg)
                    node.is_param = True
                    node.param_name = param_name
                    node.param_type = param_type
                    curr.children.append(node)
                    curr = node
                else:
                    curr = param_child
            elif seg == "*":
                wc_child = curr.find_wildcard_child()
                if wc_child is None:
                    node = RouteNode("*")
                    node.is_wildcard = True
                    curr.children.append(node)
                    curr = node
                else:
                    curr = wc_child
                break
            else:
                static_child = curr.find_static_child(seg)
                if static_child is None:
                    node = RouteNode(seg)
                    curr.children.append(node)
                    curr = node
                else:
                    curr = static_child

        curr.handlers[method] = handler

    def _is_numeric(self, s: str) -> bool:
        if len(s) == 0:
            return False
        for i in range(len(s)):
            b = ord(s[i])
            if b < 48 or b > 57:
                return False
        return True

    def _handle_not_found(self, req: Request) -> Response:
        if self.not_found_handler is not None:
            return self.not_found_handler.handle(req)
        return Response.text("Not Found", 404)

    def _handle_method_not_allowed(self, req: Request) -> Response:
        if self.method_not_allowed_handler is not None:
            return self.method_not_allowed_handler.handle(req)
        return Response.text("Method Not Allowed", 405)

    def dispatch(self, req: Request) -> Response:
        # 1. Zero-copy Fast-path for static routes: 0 path string allocation, 0 tree walk
        if self.has_static_routes:
            p = req.path
            # Strip trailing slash without allocations if len > 1
            if p.len > 1 and p.ptr[p.len - 1] == byte(47): # '/'
                p = ByteSlice(p.ptr, p.len - 1)
            bs_key = (req.method, p)
            if bs_key in self.static_routes_bs:
                if len(req.path_params) > 0:
                    req.path_params.clear()
                if len(req.fast_params) > 0:
                    req.fast_params.clear()
                return self.static_routes_bs[bs_key].handle(req)

        # 2. General dynamic route matching (100% Zero-Allocation & Zero-Copy Sliding Window)
        if len(req.fast_params) > 0:
            req.fast_params.clear()
        if len(req.path_params) > 0:
            req.path_params.clear()

        p = req.path
        plen = p.len
        pptr = p.ptr
        idx = 0
        curr = self.root

        while idx < plen:
            # Skip slashes
            while idx < plen and pptr[idx] == byte(47): # '/'
                idx += 1
            if idx >= plen:
                break
            start = idx
            while idx < plen and pptr[idx] != byte(47):
                idx += 1
            seg_len = idx - start
            seg_slice = ByteSlice(pptr + start, seg_len)

            # 1. Static match
            static_child = curr.find_static_child_slice(seg_slice)
            if static_child is not None:
                curr = static_child
                continue

            # 2. Param match
            param_child = curr.find_param_child()
            if param_child is not None:
                if param_child.param_type == "int":
                    ok, _ = seg_slice.parse_int()
                    if not ok:
                        return Response.text("Invalid path parameter type", 400)
                req.fast_params.append((param_child.param_name, seg_slice))
                curr = param_child
                continue

            # 3. Wildcard match
            wc_child = curr.find_wildcard_child()
            if wc_child is not None:
                # Capture all remaining path characters as a raw slice
                wc_slice = ByteSlice(pptr + start, plen - start)
                req.fast_params.append(("*", wc_slice))
                curr = wc_child
                break

            return self._handle_not_found(req)

        # Check method handler
        if req.method in curr.handlers:
            h = curr.handlers[req.method]
            return h.handle(req)

        if len(curr.handlers) > 0:
            return self._handle_method_not_allowed(req)

        return self._handle_not_found(req)

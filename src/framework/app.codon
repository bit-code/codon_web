            self.add_async_route(
                METHOD_PATCH, path, async_fn,
                summary=summary, description=description, tags=tags,
                dependencies=dependencies, schema=schema, has_schema=has_schema or (len(schema.rules) > 0),
                params=params, security_schemes=security_schemes,
                status_code=status_code, deprecated=deprecated
            )
            return async_fn
        return decorator

    def head(self, path: str):
        def decorator(fn: Callable[[Request], Response]):
            self.add_route(METHOD_HEAD, path, fn)
            return fn
        return decorator

    def options(self, path: str):
        def decorator(fn: Callable[[Request], Response]):
            self.add_route(METHOD_OPTIONS, path, fn)
            return fn
        return decorator

    def _run_worker(self, worker_id: int) -> None:
        # Optional CPU Affinity Pinning for Multi-Reactor Workers (Default: Unpinned / False)
        if self.config.cpu_affinity:
            pinned_core = bind_cpu_core(worker_id)
            # if pinned_core >= 0:
            #     print("[CodonWeb] Worker " + str(worker_id) + " pinned to CPU Core #" + str(pinned_core))

        self.mount_openapi_routes()

        sock = Socket.create_tcp()
        sock.set_reuse_addr(True)
        sock.set_reuse_port(True)
        if self.config.tcp_nodelay:
            sock.set_tcp_nodelay(True)

        sock.bind(self.config.host, self.config.port)
        sock.listen(self.config.backlog)

        # Execute startup hooks
        for i in range(len(self.startup_hooks)):
            hook = self.startup_hooks[i]
            hook()

        # Build pipeline: global middlewares wrapping the router
        base_adapter = RouterAdapter(self.router.radix)
        pipeline_handler = build_middleware_pipeline(self.middlewares, base_adapter)

        loop = EventLoop(
            listen_socket=sock,
            handler=pipeline_handler,
            max_events=self.config.epoll_max_events,
            buffer_size=self.config.read_buffer_size,
            keep_alive_timeout_sec=float(self.config.keep_alive_timeout_ms) / 1000.0,
            async_timeout_sec=float(self.config.async_timeout_ms) / 1000.0,
            driver=self.config.driver
        )
        self.event_loop = loop
        loop.run()

        # Execute shutdown hooks
        for i in range(len(self.shutdown_hooks)):
            hook = self.shutdown_hooks[i]
            hook()

    def run(self, host: str = "", port: int = 0, workers: int = 0, cpu_affinity: Optional[bool] = None) -> None:
        if len(host) > 0:
            self.config.host = host
        if port > 0:
            self.config.port = port
        if cpu_affinity is not None:
            self.config.cpu_affinity = cpu_affinity
        w = workers if workers > 0 else self.config.workers
        if w <= 0:
            w = 1

        print("[CodonWeb] Starting server on http://" + self.config.host + ":" + str(self.config.port))
        if self.enable_openapi:
            print("[CodonWeb] Interactive API Docs: http://" + self.config.host + ":" + str(self.config.port) + self.docs_url)
            print("[CodonWeb] ReDoc Docs:           http://" + self.config.host + ":" + str(self.config.port) + self.redoc_url)
            print("[CodonWeb] OpenAPI 3.0 Spec:     http://" + self.config.host + ":" + str(self.config.port) + self.openapi_url)
        affinity_info = "Enabled" if self.config.cpu_affinity else "Disabled"
        print("[CodonWeb] Multi-Reactor workers: " + str(w) + " (CPU Affinity: " + affinity_info + "), Active middlewares: " + str(len(self.middlewares)))

        if w == 1:
            self._run_worker(0)
            return

        worker_map: dict[int, i32] = {}
        for i in range(w):
            pid = c_fork()
            if pid < i32(0):
                print("[CodonWeb] Error: failed to fork worker " + str(i))
            elif pid == i32(0):
                self._run_worker(i)
                return
            else:
                worker_map[i] = pid

        print("[CodonWeb] Master Supervisor active: monitoring " + str(len(worker_map)) + " worker processes")
        status = i32(0)

        # Industrial-grade Arbiter Loop with Auto-Restart
        while len(worker_map) > 0:
            dead_pid = c_waitpid(i32(-1), __ptr__(status), WNOHANG)
            if dead_pid > i32(0):
                dead_id = -1
                for wid, p in worker_map.items():
                    if p == dead_pid:
                        dead_id = wid
                        break

                if dead_id >= 0:
                    status_int = int(status)
                    exit_code = (status_int >> 8) & 255
                    term_sig = status_int & 127
                    print("[CodonWeb] Worker " + str(dead_id) + " (PID " + str(dead_pid) + ") exited (status=" + str(exit_code) + ", signal=" + str(term_sig) + "). Auto-respawning replacement...")

                    new_pid = c_fork()
                    if new_pid < i32(0):
                        print("[CodonWeb] Error: failed to respawn worker " + str(dead_id))
                        del worker_map[dead_id]
                    elif new_pid == i32(0):
                        self._run_worker(dead_id)
                        return
                    else:
                        worker_map[dead_id] = new_pid
                        print("[CodonWeb] Worker " + str(dead_id) + " respawned successfully (PID " + str(new_pid) + ")")
            else:
                time.sleep(0.05)

# CodonWeb Server Configuration

class ServerConfig:
    host: str
    port: int
    backlog: int
    read_buffer_size: int
    max_request_size: int
    max_headers_count: int
    epoll_max_events: int
    keep_alive_timeout_ms: int
    tcp_nodelay: bool
    reuse_port: bool
    workers: int

    def __init__(
        self,
        host: str = "0.0.0.0",
        port: int = 8000,
        backlog: int = 4096,
        read_buffer_size: int = 4096,
        max_request_size: int = 1048576,
        max_headers_count: int = 64,
        epoll_max_events: int = 1024,
        keep_alive_timeout_ms: int = 15000,
        tcp_nodelay: bool = True,
        reuse_port: bool = False,
        workers: int = 1
    ):
        self.host = host
        self.port = port
        self.backlog = backlog
        self.read_buffer_size = read_buffer_size
        self.max_request_size = max_request_size
        self.max_headers_count = max_headers_count
        self.epoll_max_events = epoll_max_events
        self.keep_alive_timeout_ms = keep_alive_timeout_ms
        self.tcp_nodelay = tcp_nodelay
        self.reuse_port = reuse_port
        self.workers = workers

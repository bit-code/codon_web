from C import memcmp(Ptr[byte], Ptr[byte], int) -> i32
from C import memchr(Ptr[byte], i32, int) -> Ptr[byte]

@llvm
def _load_u64_unaligned(p: Ptr[byte]) -> int:
    %0 = bitcast i8* %p to i64*
    %1 = load i64, i64* %0, align 1
    ret i64 %1

@inline
def _swar_tolower_u64(v: int) -> int:
    # 64-bit SIMD-within-a-register (SWAR) ASCII case folding:
    # Converts 'A'..'Z' to 'a'..'z' across 8 bytes simultaneously in pure integer ALU operations.
    v_masked = v & 0x7F7F7F7F7F7F7F7F
    not_below_A = (v_masked + 0x3F3F3F3F3F3F3F3F) & 0x8080808080808080
    above_Z = (v_masked + 0x2525252525252525) & 0x8080808080808080
    is_upper = not_below_A & (~above_Z) & (~(v & 0x8080808080808080))
    return v ^ ((is_upper >> 2) & 0x2020202020202020)

@tuple
class ByteSlice:
    ptr: Ptr[byte]
    len: int

    def __bool__(self) -> bool:
        return self.len > 0

    def is_empty(self) -> bool:
        return self.len == 0

    def get(self, idx: int) -> byte:
        if idx < 0 or idx >= self.len:
            raise IndexError("ByteSlice index out of range")
        return self.ptr[idx]

    def slice(self, start: int, end: int) -> ByteSlice:
        s = start if start >= 0 else 0
        e = end if end <= self.len else self.len
        if s >= e:
            return ByteSlice(Ptr[byte](0), 0)
        return ByteSlice(self.ptr + s, e - s)

    def equals_ascii(self, other: str) -> bool:
        if self.len != len(other):
            return False
        if self.len == 0:
            return True
        return memcmp(self.ptr, other.c_str().as_byte(), self.len) == 0

    @inline
    def equals_case_insensitive(self, other: str) -> bool:
        # Zero-FFI inlined SWAR ASCII case-insensitive comparison:
        # 1. 1-cycle fast path for identical 8-byte blocks
        # 2. Strict letter-only [A-Z] case folding (prevents '\r' vs '-' collision vulnerabilities)
        # 3. 0 foreign function calls, fully inlined by LLVM into CPU registers
        if self.len != len(other):
            return False
        if self.len == 0:
            return True

        c_str = other.c_str().as_byte()
        p1 = self.ptr
        p2 = c_str
        rem = self.len
        offset = 0

        # SWAR 64-bit vector comparison (8 ASCII bytes per instruction, branchless)
        while rem >= 8:
            w1 = _load_u64_unaligned(p1 + offset)
            w2 = _load_u64_unaligned(p2 + offset)
            if w1 != w2:
                if _swar_tolower_u64(w1) != _swar_tolower_u64(w2):
                    return False
            offset += 8
            rem -= 8

        # Tail comparison for remaining 1..7 bytes
        while offset < self.len:
            b1 = int(p1[offset])
            b2 = int(p2[offset])
            if b1 != b2:
                c1 = b1 + 32 if 65 <= b1 <= 90 else b1
                c2 = b2 + 32 if 65 <= b2 <= 90 else b2
                if c1 != c2:
                    return False
            offset += 1

        return True

    def equals_slice(self, other: ByteSlice) -> bool:
        if self.len != other.len:
            return False
        if self.len == 0:
            return True
        return memcmp(self.ptr, other.ptr, self.len) == 0

    def __eq__(self, other: ByteSlice) -> bool:
        return self.equals_slice(other)

    def __ne__(self, other: ByteSlice) -> bool:
        return not self.equals_slice(other)

    def __hash__(self) -> int:
        # 64-bit FNV-1a Hash for zero-copy dictionary key lookup
        h = -3750763034362895579 # 0xcbf29ce484222325 as signed int64
        idx = 0
        rem = self.len
        p = self.ptr
        # SWAR 8-byte chunk hashing
        while rem >= 8:
            w = _load_u64_unaligned(p + idx)
            h = (h ^ w) * 1099511628211
            idx += 8
            rem -= 8
        # Remaining tail bytes
        while idx < self.len:
            h = (h ^ int(p[idx])) * 1099511628211
            idx += 1
        return h

    def to_str(self) -> str:
        if self.len <= 0:
            return ""
        buf = Ptr[byte](self.len + 1)
        str.memcpy(buf.as_byte(), self.ptr.as_byte(), self.len)
        buf[self.len] = byte(0)
        return str(buf, self.len)

    def find_byte(self, target: byte) -> int:
        # Hardware SIMD-accelerated byte lookup via libc memchr
        if self.len <= 0:
            return -1
        res = memchr(self.ptr, i32(target), self.len)
        if res:
            return int(res - self.ptr)
        return -1

    def trim(self) -> ByteSlice:
        # Zero-allocation stripping of ASCII whitespace (SP, TAB, LF, CR)
        if self.len <= 0:
            return ByteSlice(Ptr[byte](0), 0)
        start = 0
        end = self.len
        while start < end:
            b = self.ptr[start]
            if b == byte(32) or b == byte(9) or b == byte(10) or b == byte(13):
                start += 1
            else:
                break
        while end > start:
            b = self.ptr[end - 1]
            if b == byte(32) or b == byte(9) or b == byte(10) or b == byte(13):
                end -= 1
            else:
                break
        if start >= end:
            return ByteSlice(Ptr[byte](0), 0)
        return ByteSlice(self.ptr + start, end - start)

    def split_once(self, delim: byte) -> Tuple[ByteSlice, ByteSlice, bool]:
        # Fast zero-copy key-value separation
        idx = self.find_byte(delim)
        if idx < 0:
            return (self, ByteSlice(Ptr[byte](0), 0), False)
        return (ByteSlice(self.ptr, idx), ByteSlice(self.ptr + idx + 1, self.len - idx - 1), True)

    def parse_int(self) -> Tuple[bool, int]:
        # Industrial-Grade ASCII Integer Parser:
        # 1. Zero allocation, no exceptions
        # 2. Fast-path for 1..8 digits (guaranteed no 64-bit overflow, covering >95% HTTP metrics)
        # 3. Full 64-bit signed boundary check [-9223372036854775808, 9223372036854775807]
        #    via safe negative accumulation to prevent silent integer wrap-around vulnerabilities.
        if self.len == 0:
            return (False, 0)
        idx = 0
        neg = False
        first = self.ptr[0]
        if first == byte(45): # '-'
            neg = True
            idx = 1
        elif first == byte(43): # '+'
            idx = 1

        digits_len = self.len - idx
        if digits_len <= 0:
            return (False, 0)

        # Fast path: 1..8 decimal digits can never overflow 64-bit int (max 99,999,999 << 9e18)
        if digits_len <= 8:
            val = 0
            while idx < self.len:
                b = int(self.ptr[idx])
                if b < 48 or b > 57:
                    return (False, 0)
                val = val * 10 + (b - 48)
                idx += 1
            return (True, -val if neg else val)

        # General path with strict 64-bit boundary check (RFC 9110 compliant)
        # INT64_MIN = -9223372036854775808, INT64_MAX = 9223372036854775807
        CUTOFF_NEG: int = -922337203685477580 # INT64_MIN // 10
        CUTLIM_NEG: int = 8
        CUTLIM_POS: int = 7

        neg_limit = CUTLIM_NEG if neg else CUTLIM_POS
        val_neg = 0

        while idx < self.len:
            b = int(self.ptr[idx])
            if b < 48 or b > 57:
                return (False, 0)
            digit = b - 48
            if val_neg < CUTOFF_NEG or (val_neg == CUTOFF_NEG and digit > neg_limit):
                return (False, 0) # Overflow detected, fail fast and safe
            val_neg = val_neg * 10 - digit
            idx += 1

        return (True, val_neg if neg else -val_neg)

    def parse_hex(self) -> Tuple[bool, int]:
        # Industrial-Grade Hexadecimal Parser for HTTP/1.1 Chunked Transfer Encoding:
        # Supports optional '0x'/'0X' prefix, strict 64-bit overflow prevention (max 16 hex digits).
        if self.len == 0:
            return (False, 0)
        idx = 0
        if self.len >= 2 and self.ptr[0] == byte(48) and (self.ptr[1] == byte(120) or self.ptr[1] == byte(88)): # 0x / 0X
            idx = 2
        if idx >= self.len:
            return (False, 0)

        val = 0
        digits = 0
        while idx < self.len:
            b = int(self.ptr[idx])
            d = -1
            if 48 <= b <= 57: # '0'..'9'
                d = b - 48
            elif 97 <= b <= 102: # 'a'..'f'
                d = b - 87
            elif 65 <= b <= 70: # 'A'..'F'
                d = b - 55
            else:
                return (False, 0)

            # Max 16 hex digits for 64-bit integer
            if digits >= 16 or (val > 0x0FFFFFFFFFFFFFFF):
                return (False, 0) # Hex overflow
            val = (val << 4) | d
            digits += 1
            idx += 1

        return (True, val)


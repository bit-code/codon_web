import time
from typing import Optional, Tuple
import asyncio
from asyncio import (
    EventLoop as BaseEventLoop,
    Future,
    Task,
    gather,
    get_event_loop as get_base_loop,
    set_event_loop as set_base_loop,
    _EnterLoop
)
from src.runtime.epoll import Epoll, EpollEvent
from src.os.constants import (
    EPOLLIN, EPOLLOUT, EPOLLERR, EPOLLHUP, EPOLLRDHUP, EPOLLET
)

async def _async_callback_wrapper(cb):
    cb()

class FdCallback:
    coro: cobj

    def __init__(self, coro: cobj = cobj()):
        self.coro = coro

    def run(self):
        if bool(self.coro):
            g = Generator[None](self.coro)
            g.__resume__()

class FdHandler:
    read_cb: Optional[FdCallback]
    write_cb: Optional[FdCallback]
    read_fut: Optional[Future[bool]]
    write_fut: Optional[Future[bool]]
    events: u32
    is_persistent: bool

    def __init__(self, is_persistent: bool = False):
        self.read_cb = None
        self.write_cb = None
        self.read_fut = None
        self.write_fut = None
        self.events = u32(0)
        self.is_persistent = is_persistent

class EpollEventLoop:
    base_loop: BaseEventLoop
    epoll: Epoll
    handlers: dict[int, FdHandler]
    is_running: bool

    def __init__(self, base_loop: Optional[BaseEventLoop] = None, max_events: int = 1024, epoll: Optional[Epoll] = None):
        if base_loop is None:
            self.base_loop = get_base_loop()
        else:
            self.base_loop = base_loop
        if epoll is None:
            self.epoll = Epoll(max_events)
        else:
            self.epoll = epoll
        self.handlers = {}
        self.is_running = False

    def has_handlers(self) -> bool:
        """Check if any async I/O handlers are currently active."""
        return len(self.handlers) > 0

    def has_fd_handler(self, fd: int) -> bool:
        """Check whether a given file descriptor is registered in the async I/O handlers."""
        return fd in self.handlers

    def register_persistent_fd(self, fd: int) -> None:
        """Register a long-lived persistent fd in EPOLLET mode (e.g. database client sockets) to eliminate epoll_ctl thrashing."""
        if fd not in self.handlers:
            h = FdHandler(is_persistent=True)
            h.events = u32(EPOLLIN | EPOLLET | EPOLLRDHUP)
            self.handlers[fd] = h
            self.epoll.add(i32(fd), h.events)
        else:
            h = self.handlers[fd]
            h.is_persistent = True
            h.events = u32(h.events | u32(EPOLLIN | EPOLLET | EPOLLRDHUP))
            try:
                self.epoll.modify(i32(fd), h.events)
            except:
                self.epoll.add(i32(fd), h.events)

    def unregister_fd(self, fd: int) -> None:
        """Explicitly unregister and clean up a persistent or active file descriptor from epoll."""
        if fd in self.handlers:
            h = self.handlers[fd]
            h.read_fut = None
            h.write_fut = None
            try:
                self.epoll.remove(i32(fd))
            except:
                pass
            del self.handlers[fd]

    def handle_fd_event(self, fd: int, ev_mask: u32) -> None:
        """Dispatch ready I/O event to registered coroutine reader/writer callbacks or direct futures."""
        if fd in self.handlers:
            h = self.handlers[fd]
            # Priority: writable first, then readable/error
            if (ev_mask & u32(EPOLLOUT)) != u32(0):
                if h.write_fut is not None:
                    w_fut = h.write_fut
                    h.write_fut = None
                    w_fut.set_result(True)
                if h.write_cb is not None:
                    h.write_cb.run()
            if (ev_mask & u32(EPOLLIN | EPOLLHUP | EPOLLERR | EPOLLRDHUP)) != u32(0):
                if h.read_fut is not None:
                    r_fut = h.read_fut
                    h.read_fut = None
                    r_fut.set_result(True)
                if h.read_cb is not None:
                    h.read_cb.run()

            # Clean up one-shot waiters once completed; KEEP persistent handlers in epoll tree!
            if not h.is_persistent:
                if h.read_fut is None and h.write_fut is None and h.read_cb is None and h.write_cb is None:
                    try:
                        self.epoll.remove(i32(fd))
                    except:
                        pass
                    del self.handlers[fd]

    def wait_readable(self, fd: int, fut: Future[bool]) -> None:
        """Direct zero-overhead registration: resolve `fut` when `fd` becomes readable."""
        if fd not in self.handlers:
            h = FdHandler(is_persistent=False)
            h.read_fut = fut
            h.events = u32(EPOLLIN | EPOLLRDHUP)
            self.handlers[fd] = h
            self.epoll.add(i32(fd), h.events)
        else:
            h = self.handlers[fd]
            h.read_fut = fut
            if not h.is_persistent:
                h.events = u32(h.events | u32(EPOLLIN | EPOLLRDHUP))
                try:
                    self.epoll.modify(i32(fd), h.events)
                except:
                    self.epoll.add(i32(fd), h.events)

    def wait_writable(self, fd: int, fut: Future[bool]) -> None:
        """Direct zero-overhead registration: resolve `fut` when `fd` becomes writable."""
        if fd not in self.handlers:
            h = FdHandler(is_persistent=False)
            h.write_fut = fut
            h.events = u32(EPOLLOUT)
            self.handlers[fd] = h
            self.epoll.add(i32(fd), h.events)
        else:
            h = self.handlers[fd]
            h.write_fut = fut
            h.events = u32(h.events | u32(EPOLLOUT))
            try:
                self.epoll.modify(i32(fd), h.events)
            except:
                self.epoll.add(i32(fd), h.events)


    def cancel_wait(self, fd: int) -> None:
        """Cancel active waiting future on file descriptor `fd` and unregister from epoll."""
        if fd in self.handlers:
            h = self.handlers[fd]
            h.read_fut = None
            h.write_fut = None
            if not h.is_persistent:
                if h.read_cb is None and h.write_cb is None:
                    try:
                        self.epoll.remove(i32(fd))
                    except:
                        pass
                    del self.handlers[fd]
                else:
                    h.events = u32(0)
                    if h.read_cb is not None:
                        h.events = u32(h.events | u32(EPOLLIN | EPOLLRDHUP))
                    if h.write_cb is not None:
                        h.events = u32(h.events | u32(EPOLLOUT))
                    if h.events == u32(0):
                        try:
                            self.epoll.remove(i32(fd))
                        except:
                            pass
                        del self.handlers[fd]
                    else:
                        self.epoll.modify(i32(fd), h.events)

    def has_pending_tasks(self) -> bool:
        """Check whether there are ready coroutines waiting in the base loop work queue."""
        return not self.base_loop._work_empty()

    def step(self) -> None:
        """Advance coroutine scheduler by one step if work is ready."""
        loop = self.base_loop
        with _EnterLoop(loop):
            if not loop._work_empty():
                loop._step()

    def add_reader(self, fd: int, callback) -> None:
        """Register a callback to be invoked when file descriptor `fd` is ready for reading."""
        c = _async_callback_wrapper(callback)
        cb_item = FdCallback(c.__raw__())
        if fd not in self.handlers:
            h = FdHandler()
            h.read_cb = cb_item
            h.events = u32(EPOLLIN | EPOLLRDHUP)
            self.handlers[fd] = h
            self.epoll.add(i32(fd), h.events)
        else:
            h = self.handlers[fd]
            h.read_cb = cb_item
            h.events = u32(h.events | u32(EPOLLIN | EPOLLRDHUP))
            self.epoll.modify(i32(fd), h.events)

    def remove_reader(self, fd: int) -> None:
        """Unregister reading callback for file descriptor `fd`."""
        if fd in self.handlers:
            h = self.handlers[fd]
            h.read_cb = None
            h.events = u32(h.events & (~u32(EPOLLIN | EPOLLRDHUP)))
            if h.write_cb is None:
                self.epoll.remove(i32(fd))
                del self.handlers[fd]
            else:
                self.epoll.modify(i32(fd), h.events)

    def add_writer(self, fd: int, callback) -> None:
        """Register a callback to be invoked when file descriptor `fd` is ready for writing."""
        c = _async_callback_wrapper(callback)
        cb_item = FdCallback(c.__raw__())
        if fd not in self.handlers:
            h = FdHandler()
            h.write_cb = cb_item
            h.events = u32(EPOLLOUT)
            self.handlers[fd] = h
            self.epoll.add(i32(fd), h.events)
        else:
            h = self.handlers[fd]
            h.write_cb = cb_item
            h.events = u32(h.events | u32(EPOLLOUT))
            self.epoll.modify(i32(fd), h.events)

    def remove_writer(self, fd: int) -> None:
        """Unregister writing callback for file descriptor `fd`."""
        if fd in self.handlers:
            h = self.handlers[fd]
            h.write_cb = None
            h.events = u32(h.events & (~u32(EPOLLOUT)))
            if h.read_cb is None:
                self.epoll.remove(i32(fd))
                del self.handlers[fd]
            else:
                self.epoll.modify(i32(fd), h.events)

    def poll_io(self, timeout_ms: int = 0) -> int:
        """Wait for I/O events using Linux Epoll and execute ready handlers."""
        if len(self.handlers) == 0:
            return 0
        events = self.epoll.wait(timeout_ms)
        n = len(events)
        for i in range(n):
            ev = events[i]
            self.handle_fd_event(int(ev.fd), ev.events)
        return n

    def call_later(self, delay: float, callback, *args):
        """Schedule a callback to be called after `delay` seconds."""
        return self.base_loop.call_later(delay, callback, *args)

    def call_soon(self, callback, *args):
        """Schedule a callback to be called on the next iteration."""
        return self.base_loop.call_soon(callback, *args)

    def create_future(self, T: type = NoneType):
        """Create a standard typed asyncio.Future."""
        return self.base_loop.create_future(T)

    def create_task(self, coro, name: Optional[str] = None):
        """Wrap a coroutine into an asyncio.Task and schedule it."""
        return self.base_loop.create_task(coro, name=name)

    def run_until_complete(self, task):
        """Run the event loop with Epoll multiplexing until `task` finishes."""
        loop = self.base_loop
        self.is_running = True
        with _EnterLoop(loop):
            while not task.done():
                # 1. If work is ready in queue, run it immediately without I/O wait
                if not loop._work_empty():
                    loop._step()
                    if task.done():
                        break
                    continue

                # 2. Work queue is empty: tasks are suspended waiting on I/O or timers.
                timeout_ms = 0
                now = time.time()
                if loop._timers_len > 0:
                    dt = loop._timers[0].when - now
                    if dt <= 0.0:
                        loop._step()
                        continue
                    timeout_ms = min(10, max(1, int(dt * 1000.0)))
                else:
                    timeout_ms = 5 if len(self.handlers) > 0 else 0

                # 3. Poll Epoll directly to wake up waiting tasks
                n_events = self.poll_io(timeout_ms)
                if n_events == 0 and loop._timers_len == 0 and len(self.handlers) == 0:
                    time.sleep(0.001)

            self.is_running = False
            return task.result()

    def run_one_iteration(self, max_timeout_ms: int = 5) -> None:
        """Single non-blocking or bounded step for integration into external loops."""
        loop = self.base_loop
        with _EnterLoop(loop):
            loop._step()
            timeout = max_timeout_ms if len(self.handlers) > 0 else 0
            n_events = self.poll_io(timeout)
            if n_events > 0:
                loop._step()

_default_loop: Optional[EpollEventLoop] = None

def get_event_loop() -> EpollEventLoop:
    """Return the global EpollEventLoop instance for current thread."""
    global _default_loop
    if _default_loop is None:
        _default_loop = EpollEventLoop()
    return _default_loop

def set_event_loop(loop: EpollEventLoop) -> None:
    """Set the current global EpollEventLoop instance."""
    global _default_loop
    _default_loop = loop
    set_base_loop(loop.base_loop)

def run(coro):
    """Execute a top-level coroutine to completion using the EpollEventLoop."""
    loop = get_event_loop()
    task = loop.create_task(coro)
    return loop.run_until_complete(task)

def create_task(coro, name: Optional[str] = None):
    """Convenience shortcut to create an asynchronous task on the current loop."""
    return get_event_loop().create_task(coro, name=name)

async def wait_for(coro, timeout_sec: float):
    """
    Wait for `coro` to complete with a deadline.
    If timeout expires before completion, the underlying Task is cancelled
    and an OSError/TimeoutError is raised.
    """
    loop = get_event_loop()
    task = loop.create_task(coro)

    timed_out = [False]
    def on_timeout():
        timed_out[0] = True
        task.cancel()

    timer = loop.call_later(timeout_sec, on_timeout)
    try:
        res = await task
        timer.cancel()
        return res
    except:
        timer.cancel()
        if timed_out[0]:
            raise OSError(f"Timeout: Operation exceeded {timeout_sec}s deadline")
        raise

async def gather2(coro1, coro2):
    """
    Run two coroutines concurrently and await their results into a typed tuple (res1, res2).
    If either coroutine raises an exception, the sibling task is cancelled immediately.
    """
    loop = get_event_loop()
    t1 = loop.create_task(coro1)
    t2 = loop.create_task(coro2)

    try:
        r1 = await t1
    except:
        t2.cancel()
        raise

    try:
        r2 = await t2
    except:
        raise

    return (r1, r2)

async def gather3(coro1, coro2, coro3):
    """
    Run three coroutines concurrently and await their results into a typed tuple (res1, res2, res3).
    If any coroutine raises an exception, sibling tasks are cancelled immediately.
    """
    loop = get_event_loop()
    t1 = loop.create_task(coro1)
    t2 = loop.create_task(coro2)
    t3 = loop.create_task(coro3)

    try:
        r1 = await t1
    except:
        t2.cancel()
        t3.cancel()
        raise

    try:
        r2 = await t2
    except:
        t3.cancel()
        raise

    try:
        r3 = await t3
    except:
        raise

    return (r1, r2, r3)



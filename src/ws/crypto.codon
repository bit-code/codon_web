# Pure Codon High-Performance Crypto Primitives for WebSocket (RFC 6455) & Security

# 1. Base64 Encoding and Decoding
_B64_TABLE = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

def base64_encode(data: list[byte]) -> str:
    n = len(data)
    if n == 0:
        return ""
    res = list[str]()
    i = 0
    while i < n:
        b0 = int(data[i])
        b1 = int(data[i + 1]) if i + 1 < n else 0
        b2 = int(data[i + 2]) if i + 2 < n else 0
        triple = (b0 << 16) | (b1 << 8) | b2

        res.append(_B64_TABLE[(triple >> 18) & 0x3F])
        res.append(_B64_TABLE[(triple >> 12) & 0x3F])
        if i + 1 < n:
            res.append(_B64_TABLE[(triple >> 6) & 0x3F])
        else:
            res.append('=')
        if i + 2 < n:
            res.append(_B64_TABLE[triple & 0x3F])
        else:
            res.append('=')
        i += 3
    return "".join(res)

def base64_decode(s: str) -> list[byte]:
    lookup = dict[int, int]()
    for idx in range(len(_B64_TABLE)):
        lookup[ord(_B64_TABLE[idx])] = idx

    buf = 0
    bits = 0
    res = list[byte]()

    for i in range(len(s)):
        c = s[i]
        if c == '=':
            break
        code = ord(c)
        if code in lookup:
            buf = (buf << 6) | lookup[code]
            bits += 6
            if bits >= 8:
                bits -= 8
                byte_val = (buf >> bits) & 0xFF
                res.append(byte(byte_val))

    return res

# 2. Pure Codon RFC 3174 SHA-1 Implementation
def _rotl32(v: int, bits: int) -> int:
    return ((v << bits) | (v >> (32 - bits))) & 0xFFFFFFFF

def sha1(data: list[byte]) -> list[byte]:
    h0 = 0x67452301
    h1 = 0xEFCDAB89
    h2 = 0x98BADCFE
    h3 = 0x10325476
    h4 = 0xC3D2E1F0

    orig_len_bytes = len(data)
    orig_len_bits = orig_len_bytes * 8

    # Pad message
    padded = list[byte]()
    for i in range(orig_len_bytes):
        padded.append(data[i])
    padded.append(byte(0x80))

    while (len(padded) % 64) != 56:
        padded.append(byte(0x00))

    # Append 64-bit length in big-endian
    for shift in range(56, -8, -8):
        padded.append(byte((orig_len_bits >> shift) & 0xFF))

    # Process 512-bit (64-byte) chunks
    num_chunks = len(padded) // 64
    w = [0] * 80

    for chunk_idx in range(num_chunks):
        base_offset = chunk_idx * 64
        for i in range(16):
            idx = base_offset + (i * 4)
            b0 = int(padded[idx])
            b1 = int(padded[idx + 1])
            b2 = int(padded[idx + 2])
            b3 = int(padded[idx + 3])
            w[i] = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3

        for i in range(16, 80):
            w[i] = _rotl32(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1)

        a = h0
        b = h1
        c = h2
        d = h3
        e = h4

        for i in range(80):
            if i < 20:
                f = (b & c) | ((~b) & d)
                k = 0x5A827999
            elif i < 40:
                f = b ^ c ^ d
                k = 0x6ED9EBA1
            elif i < 60:
                f = (b & c) | (b & d) | (c & d)
                k = 0x8F1BBCDC
            else:
                f = b ^ c ^ d
                k = 0xCA62C1D6

            temp = (_rotl32(a, 5) + f + e + k + w[i]) & 0xFFFFFFFF
            e = d
            d = c
            c = _rotl32(b, 30)
            b = a
            a = temp

        h0 = (h0 + a) & 0xFFFFFFFF
        h1 = (h1 + b) & 0xFFFFFFFF
        h2 = (h2 + c) & 0xFFFFFFFF
        h3 = (h3 + d) & 0xFFFFFFFF
        h4 = (h4 + e) & 0xFFFFFFFF

    out = list[byte]()
    for h in [h0, h1, h2, h3, h4]:
        out.append(byte((h >> 24) & 0xFF))
        out.append(byte((h >> 16) & 0xFF))
        out.append(byte((h >> 8) & 0xFF))
        out.append(byte(h & 0xFF))
    return out

def sha1_str(s: str) -> list[byte]:
    data = list[byte]()
    for i in range(len(s)):
        data.append(byte(ord(s[i])))
    return sha1(data)

def sha1_hex(s: str) -> str:
    h = sha1_str(s)
    hex_chars = "0123456789abcdef"
    res = list[str]()
    for i in range(len(h)):
        v = int(h[i])
        res.append(hex_chars[(v >> 4) & 0xF])
        res.append(hex_chars[v & 0xF])
    return "".join(res)

# 3. Pure Codon FIPS 180-4 SHA-256 Implementation
def _rotr32(v: int, bits: int) -> int:
    return ((v >> bits) | (v << (32 - bits))) & 0xFFFFFFFF

_K256 = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
]

def sha256(data: list[byte]) -> list[byte]:
    h0 = 0x6a09e667
    h1 = 0xbb67ae85
    h2 = 0x3c6ef372
    h3 = 0xa54ff53a
    h4 = 0x510e527f
    h5 = 0x9b05688c
    h6 = 0x1f83d9ab
    h7 = 0x5be0cd19

    orig_len_bytes = len(data)
    orig_len_bits = orig_len_bytes * 8

    padded = list[byte]()
    for i in range(orig_len_bytes):
        padded.append(data[i])
    padded.append(byte(0x80))

    while (len(padded) % 64) != 56:
        padded.append(byte(0x00))

    for shift in range(56, -8, -8):
        padded.append(byte((orig_len_bits >> shift) & 0xFF))

    num_chunks = len(padded) // 64
    w = [0] * 64

    for chunk_idx in range(num_chunks):
        base_offset = chunk_idx * 64
        for i in range(16):
            idx = base_offset + (i * 4)
            b0 = int(padded[idx])
            b1 = int(padded[idx + 1])
            b2 = int(padded[idx + 2])
            b3 = int(padded[idx + 3])
            w[i] = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3

        for i in range(16, 64):
            s0 = _rotr32(w[i - 15], 7) ^ _rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3)
            s1 = _rotr32(w[i - 2], 17) ^ _rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10)
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & 0xFFFFFFFF

        a = h0
        b = h1
        c = h2
        d = h3
        e = h4
        f = h5
        g = h6
        h = h7

        for i in range(64):
            s1 = _rotr32(e, 6) ^ _rotr32(e, 11) ^ _rotr32(e, 25)
            ch = (e & f) ^ ((~e) & g)
            temp1 = (h + s1 + ch + _K256[i] + w[i]) & 0xFFFFFFFF
            s0 = _rotr32(a, 2) ^ _rotr32(a, 13) ^ _rotr32(a, 22)
            maj = (a & b) ^ (a & c) ^ (b & c)
            temp2 = (s0 + maj) & 0xFFFFFFFF

            h = g
            g = f
            f = e
            e = (d + temp1) & 0xFFFFFFFF
            d = c
            c = b
            b = a
            a = (temp1 + temp2) & 0xFFFFFFFF

        h0 = (h0 + a) & 0xFFFFFFFF
        h1 = (h1 + b) & 0xFFFFFFFF
        h2 = (h2 + c) & 0xFFFFFFFF
        h3 = (h3 + d) & 0xFFFFFFFF
        h4 = (h4 + e) & 0xFFFFFFFF
        h5 = (h5 + f) & 0xFFFFFFFF
        h6 = (h6 + g) & 0xFFFFFFFF
        h7 = (h7 + h) & 0xFFFFFFFF

    out = list[byte]()
    for val in [h0, h1, h2, h3, h4, h5, h6, h7]:
        out.append(byte((val >> 24) & 0xFF))
        out.append(byte((val >> 16) & 0xFF))
        out.append(byte((val >> 8) & 0xFF))
        out.append(byte(val & 0xFF))
    return out

def sha256_str(s: str) -> list[byte]:
    data = list[byte]()
    for i in range(len(s)):
        data.append(byte(ord(s[i])))
    return sha256(data)

def sha256_hex(s: str) -> str:
    h = sha256_str(s)
    hex_chars = "0123456789abcdef"
    res = list[str]()
    for i in range(len(h)):
        v = int(h[i])
        res.append(hex_chars[(v >> 4) & 0xF])
        res.append(hex_chars[v & 0xF])
    return "".join(res)

# 4. RFC 2104 HMAC-SHA256 Implementation
def hmac_sha256(key: list[byte], msg: list[byte]) -> list[byte]:
    k = list[byte]()
    if len(key) > 64:
        hashed_k = sha256(key)
        for i in range(len(hashed_k)):
            k.append(hashed_k[i])
    else:
        for i in range(len(key)):
            k.append(key[i])
    while len(k) < 64:
        k.append(byte(0))

    o_key_pad = list[byte]()
    i_key_pad = list[byte]()
    for i in range(64):
        o_key_pad.append(byte(int(k[i]) ^ 0x5C))
        i_key_pad.append(byte(int(k[i]) ^ 0x36))

    inner_data = list[byte]()
    for i in range(64):
        inner_data.append(i_key_pad[i])
    for i in range(len(msg)):
        inner_data.append(msg[i])
    inner_hash = sha256(inner_data)

    outer_data = list[byte]()
    for i in range(64):
        outer_data.append(o_key_pad[i])
    for i in range(len(inner_hash)):
        outer_data.append(inner_hash[i])

    return sha256(outer_data)

def hmac_sha256_hex(key_str: str, msg_str: str) -> str:
    k_bytes = list[byte]()
    for i in range(len(key_str)):
        k_bytes.append(byte(ord(key_str[i])))
    m_bytes = list[byte]()
    for i in range(len(msg_str)):
        m_bytes.append(byte(ord(msg_str[i])))

    h = hmac_sha256(k_bytes, m_bytes)
    hex_chars = "0123456789abcdef"
    res = list[str]()
    for i in range(len(h)):
        v = int(h[i])
        res.append(hex_chars[(v >> 4) & 0xF])
        res.append(hex_chars[v & 0xF])
    return "".join(res)

# 5. Constant-time string comparison to prevent Timing Attacks
def constant_time_compare(a: str, b: str) -> bool:
    if len(a) != len(b):
        return False
    diff = 0
    for i in range(len(a)):
        diff = diff | (ord(a[i]) ^ ord(b[i]))
    return diff == 0


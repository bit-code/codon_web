# Industrial-Grade Database Connection Pool for Codon

from src.db.errors import OperationalError, InterfaceError
from src.db.drivers.mysql.connection import MySQLConnection

class PooledMySQLConnection[PoolType]:
    _pool: PoolType
    conn: MySQLConnection
    _released: bool

    def __init__(self, pool: PoolType, conn: MySQLConnection):
        self._pool = pool
        self.conn = conn
        self._released = False

    def cursor(self):
        return self.conn.cursor()

    def commit(self) -> None:
        self.conn.commit()

    def rollback(self) -> None:
        self.conn.rollback()

    def ping(self, reconnect: bool = True) -> bool:
        return self.conn.ping(reconnect)

    def __enter__(self):
        return self

    def __exit__(self):
        self.release()

    def release(self) -> None:
        if not self._released:
            self._released = True
            self._pool.release(self.conn)

class MySQLPool:
    host: str
    port: int
    user: str
    password: str
    database: str
    charset: str
    autocommit: bool
    min_size: int
    max_size: int

    _available: List[MySQLConnection]
    _total_created: int

    def __init__(
        self,
        host: str = "127.0.0.1",
        port: int = 3306,
        user: str = "root",
        password: str = "",
        database: str = "",
        charset: str = "utf8mb4",
        autocommit: bool = True,
        min_size: int = 2,
        max_size: int = 16
    ):
        self.host = host
        self.port = port
        self.user = user
        self.password = password
        self.database = database
        self.charset = charset
        self.autocommit = autocommit
        self.min_size = min_size
        self.max_size = max_size

        self._available = List[MySQLConnection]()
        self._total_created = 0

        # Pre-warm minimum pool connections
        self._warmup()

    def _create_raw_connection(self) -> MySQLConnection:
        conn = MySQLConnection(
            host=self.host,
            port=self.port,
            user=self.user,
            password=self.password,
            database=self.database,
            charset=self.charset,
            autocommit=self.autocommit
        )
        self._total_created += 1
        return conn

    def _warmup(self) -> None:
        for _ in range(self.min_size):
            try:
                conn = self._create_raw_connection()
                self._available.append(conn)
            except Exception as e:
                # If database is initially unreachable, allow lazy connection creation
                pass

    @property
    def available_count(self) -> int:
        return len(self._available)

    @property
    def total_count(self) -> int:
        return self._total_created

    def get(self) -> MySQLConnection:
        """Acquires a healthy connection from the pool or creates a new one"""
        while len(self._available) > 0:
            conn = self._available.pop()
            if not conn.is_closed and conn.ping(reconnect=False):
                return conn
            # Connection died or server timed out, close and discard
            try:
                conn.close()
            except:
                pass
            self._total_created -= 1

        # Check capacity
        if self._total_created < self.max_size:
            return self._create_raw_connection()

        raise OperationalError(
            f"MySQL connection pool exhausted! (Active: {self._total_created}, Max: {self.max_size})"
        )

    def release(self, conn: MySQLConnection) -> None:
        """Returns a connection back to the idle pool"""
        if conn is None:
            return
        if conn.is_closed:
            self._total_created -= 1
            return
        if len(self._available) < self.max_size:
            self._available.append(conn)
        else:
            # Over max size, close excess connection
            conn.close()
            self._total_created -= 1

    def acquire(self) -> PooledMySQLConnection[MySQLPool]:
        """Context manager for automatic connection release: with pool.acquire() as conn:"""
        conn = self.get()
        return PooledMySQLConnection[MySQLPool](self, conn)

    def close(self) -> None:
        """Closes all connections in the pool"""
        while len(self._available) > 0:
            conn = self._available.pop()
            try:
                conn.close()
            except:
                pass
        self._total_created = 0

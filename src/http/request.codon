from typing import Callable
from src.memory.slice import ByteSlice
from src.http.method import HttpMethod, METHOD_UNKNOWN
from src.http.headers import Headers
from src.http.json import Json
from src.http.fast_json import FastJson, FastJsonDoc
from src.http.background import BackgroundTasks
from src.http.multipart import MultipartFormData, parse_multipart_form_data, UploadedFile
from src.http.response import Response
from src.runtime.async_context import AsyncContext, AsyncResumer

def url_decode_slice(bs: ByteSlice) -> str:
    if bs.len == 0:
        return ""
    # Fast path: check if '%' or '+' exists
    has_special = False
    for i in range(bs.len):
        b = bs.ptr[i]
        if b == byte(37) or b == byte(43): # '%' or '+'
            has_special = True
            break
    if not has_special:
        return bs.to_str()

    res = []
    i = 0
    n = bs.len
    while i < n:
        b = bs.ptr[i]
        if b == byte(43): # '+'
            res.append(' ')
            i += 1
        elif b == byte(37) and i + 2 < n: # '%'
            h1 = int(bs.ptr[i + 1])
            h2 = int(bs.ptr[i + 2])
            v1 = -1
            v2 = -1
            if 48 <= h1 <= 57:
                v1 = h1 - 48
            elif 65 <= h1 <= 70:
                v1 = h1 - 55
            elif 97 <= h1 <= 102:
                v1 = h1 - 87
            
            if 48 <= h2 <= 57:
                v2 = h2 - 48
            elif 65 <= h2 <= 70:
                v2 = h2 - 55
            elif 97 <= h2 <= 102:
                v2 = h2 - 87
            
            if v1 >= 0 and v2 >= 0:
                byte_val = (v1 << 4) | v2
                res.append(chr(byte_val))
                i += 3
            else:
                res.append(chr(int(b)))
                i += 1
        else:
            res.append(chr(int(b)))
            i += 1
    return "".join(res)

def url_decode(s: str) -> str:
    if len(s) == 0:
        return ""
    bs = ByteSlice(s.c_str().as_byte(), len(s))
    return url_decode_slice(bs)

class Request:
    method: i32
    path: ByteSlice
    query: ByteSlice
    version: ByteSlice
    headers: Headers
    body: ByteSlice
    keep_alive: bool
    path_params: dict[str, str]
    fast_params: list[Tuple[str, ByteSlice]]
    query_params: dict[str, str]
    parsed_query: bool
    json_data: dict[str, str]
    parsed_json: bool
    json_doc_cache: Optional[FastJsonDoc]
    cookies: dict[str, str]
    parsed_cookies: bool
    form_params: dict[str, str]
    parsed_form: bool
    state: dict[str, str]
    background_tasks: BackgroundTasks
    multipart: MultipartFormData
    parsed_multipart: bool
    dep_cache_str: dict[str, str]
    fd: i32
    async_resumer: Optional[AsyncResumer]
    async_ctx: Optional[AsyncContext]

    def __init__(self):
        self.method = METHOD_UNKNOWN
        self.path = ByteSlice(Ptr[byte](0), 0)
        self.query = ByteSlice(Ptr[byte](0), 0)
        self.version = ByteSlice(Ptr[byte](0), 0)
        self.headers = Headers()
        self.body = ByteSlice(Ptr[byte](0), 0)
        self.keep_alive = True
        self.path_params = {}
        self.fast_params = list[Tuple[str, ByteSlice]]()
        self.query_params = {}
        self.parsed_query = False
        self.json_data = {}
        self.parsed_json = False
        self.json_doc_cache = None
        self.cookies = {}
        self.parsed_cookies = False
        self.form_params = {}
        self.parsed_form = False
        self.state = {}
        self.background_tasks = BackgroundTasks()
        self.multipart = MultipartFormData()
        self.parsed_multipart = False
        self.dep_cache_str = {}
        self.fd = i32(-1)
        self.async_resumer = None
        self.async_ctx = None

    def path_str(self) -> str:
        return self.path.to_str()

    def query_str(self) -> str:
        return self.query.to_str()

    def body_str(self) -> str:
        return self.body.to_str()

    def param_slice(self, name: str) -> ByteSlice:
        for i in range(len(self.fast_params)):
            if self.fast_params[i][0] == name:
                return self.fast_params[i][1]
        return ByteSlice(Ptr[byte](0), 0)

    def param(self, name: str) -> str:
        for i in range(len(self.fast_params)):
            if self.fast_params[i][0] == name:
                return self.fast_params[i][1].to_str()
        if name in self.path_params:
            return self.path_params[name]
        return ""

    def param_int(self, name: str, default_val: int = 0) -> int:
        sl = self.param_slice(name)
        if sl.len > 0:
            ok, val = sl.parse_int()
            if ok:
                return val
        val_str = self.param(name)
        if len(val_str) == 0:
            return default_val
        bs = ByteSlice(val_str.c_str().as_byte(), len(val_str))
        ok2, val2 = bs.parse_int()
        return val2 if ok2 else default_val

    def _ensure_query_parsed(self) -> None:
        if self.parsed_query:
            return
        self.parsed_query = True
        if self.query.len == 0:
            return
        
        remaining = self.query
        while remaining.len > 0:
            pair, rest, found_pair = remaining.split_once(byte(38)) # '&'
            if found_pair:
                remaining = rest
            else:
                remaining = ByteSlice(Ptr[byte](0), 0)
            if pair.len == 0:
                continue
            k_slice, v_slice, found_eq = pair.split_once(byte(61)) # '='
            if found_eq:
                k = url_decode_slice(k_slice)
                v = url_decode_slice(v_slice)
                self.query_params[k] = v
            else:
                self.query_params[url_decode_slice(pair)] = ""

    def query_param_slice(self, name: str) -> ByteSlice:
        if self.query.len == 0:
            return ByteSlice(Ptr[byte](0), 0)
        remaining = self.query
        name_bs = ByteSlice(name.c_str().as_byte(), len(name))
        while remaining.len > 0:
            pair, rest, found_pair = remaining.split_once(byte(38)) # '&'
            if found_pair:
                remaining = rest
            else:
                remaining = ByteSlice(Ptr[byte](0), 0)
            if pair.len == 0:
                continue
            k_slice, v_slice, found_eq = pair.split_once(byte(61)) # '='
            if found_eq:
                if k_slice.equals_slice(name_bs):
                    return v_slice
            else:
                if pair.equals_slice(name_bs):
                    return ByteSlice(pair.ptr + pair.len, 0)
        return ByteSlice(Ptr[byte](0), 0)

    def query_param(self, name: str, default_val: str = "") -> str:
        if self.parsed_query:
            if name in self.query_params:
                return self.query_params[name]
            return default_val
        sl = self.query_param_slice(name)
        if sl.len > 0:
            has_pct = False
            for i in range(sl.len):
                b = sl.ptr[i]
                if b == byte(37) or b == byte(43): # '%' or '+'
                    has_pct = True
                    break
            if not has_pct:
                return sl.to_str()
            return url_decode_slice(sl)
        self._ensure_query_parsed()
        if name in self.query_params:
            return self.query_params[name]
        return default_val

    def query_param_int(self, name: str, default_val: int = 0) -> int:
        sl = self.query_param_slice(name)
        if sl.len > 0:
            ok, val = sl.parse_int()
            if ok:
                return val
        s = self.query_param(name, "")
        if len(s) == 0:
            return default_val
        bs = ByteSlice(s.c_str().as_byte(), len(s))
        ok2, val2 = bs.parse_int()
        return val2 if ok2 else default_val

    def get_query_params(self) -> dict[str, str]:
        self._ensure_query_parsed()
        return self.query_params

    def header_slice(self, name: str) -> ByteSlice:
        return self.headers.get(name)

    def header(self, name: str, default_val: str = "") -> str:
        val_slice = self.headers.get(name)
        if val_slice.len == 0:
            return default_val
        return val_slice.to_str()

    def bearer_token(self) -> str:
        auth = self.headers.get("Authorization")
        if auth.len > 7 and auth.slice(0, 7).equals_case_insensitive("Bearer "):
            return auth.slice(7, auth.len).trim().to_str()
        return ""

    def _ensure_cookies_parsed(self) -> None:
        if self.parsed_cookies:
            return
        self.parsed_cookies = True
        raw_slice = self.headers.get("Cookie")
        if raw_slice.len == 0:
            return
        remaining = raw_slice
        while remaining.len > 0:
            item, rest, found_semi = remaining.split_once(byte(59)) # ';'
            if found_semi:
                remaining = rest
            else:
                remaining = ByteSlice(Ptr[byte](0), 0)
            item = item.trim()
            if item.len == 0:
                continue
            k_slice, v_slice, found_eq = item.split_once(byte(61)) # '='
            if found_eq:
                self.cookies[k_slice.trim().to_str()] = v_slice.trim().to_str()
            else:
                self.cookies[item.to_str()] = ""

    def cookie_slice(self, name: str) -> ByteSlice:
        raw_slice = self.headers.get("Cookie")
        if raw_slice.len == 0:
            return ByteSlice(Ptr[byte](0), 0)
        remaining = raw_slice
        name_bs = ByteSlice(name.c_str().as_byte(), len(name))
        while remaining.len > 0:
            item, rest, found_semi = remaining.split_once(byte(59)) # ';'
            if found_semi:
                remaining = rest
            else:
                remaining = ByteSlice(Ptr[byte](0), 0)
            item = item.trim()
            if item.len == 0:
                continue
            k_slice, v_slice, found_eq = item.split_once(byte(61)) # '='
            if found_eq:
                if k_slice.trim().equals_slice(name_bs):
                    return v_slice.trim()
            else:
                if item.equals_slice(name_bs):
                    return ByteSlice(item.ptr + item.len, 0)
        return ByteSlice(Ptr[byte](0), 0)

    def cookie(self, name: str, default_val: str = "") -> str:
        if self.parsed_cookies:
            if name in self.cookies:
                return self.cookies[name]
            return default_val
        sl = self.cookie_slice(name)
        if sl.len > 0:
            return sl.to_str()
        self._ensure_cookies_parsed()
        if name in self.cookies:
            return self.cookies[name]
        return default_val

    def _ensure_multipart_parsed(self) -> None:
        if self.parsed_multipart:
            return
        self.parsed_multipart = True
        ct = self.header("Content-Type")
        b_idx = ct.find("boundary=")
        if b_idx >= 0:
            boundary = ct[b_idx + 9:].strip()
            if boundary.startswith('"') and boundary.endswith('"') and len(boundary) >= 2:
                boundary = boundary[1:-1]
            self.multipart = parse_multipart_form_data(self.body_str(), boundary)
            # Integrate regular form fields into form_params
            for k, v in self.multipart.fields.items():
                self.form_params[k] = v

    def file(self, name: str) -> Optional[UploadedFile]:
        self._ensure_multipart_parsed()
        return self.multipart.get_file(name)

    def files(self, name: str) -> list[UploadedFile]:
        self._ensure_multipart_parsed()
        return self.multipart.get_files(name)

    def _ensure_form_parsed(self) -> None:
        if self.parsed_form:
            return
        self.parsed_form = True
        # Check if multipart first
        ct = self.header("Content-Type")
        if "multipart/form-data" in ct:
            self._ensure_multipart_parsed()
            return

        if self.body.len == 0:
            return
        remaining = self.body
        while remaining.len > 0:
            pair, rest, found_pair = remaining.split_once(byte(38)) # '&'
            if found_pair:
                remaining = rest
            else:
                remaining = ByteSlice(Ptr[byte](0), 0)
            if pair.len == 0:
                continue
            k_slice, v_slice, found_eq = pair.split_once(byte(61)) # '='
            if found_eq:
                k = url_decode_slice(k_slice)
                v = url_decode_slice(v_slice)
                self.form_params[k] = v
            else:
                self.form_params[url_decode_slice(pair)] = ""

    def form_param(self, name: str, default_val: str = "") -> str:
        self._ensure_form_parsed()
        if name in self.form_params:
            return self.form_params[name]
        return default_val

    def form_param_int(self, name: str, default_val: int = 0) -> int:
        s = self.form_param(name, "")
        if len(s) == 0:
            return default_val
        bs = ByteSlice(s.c_str().as_byte(), len(s))
        ok, val = bs.parse_int()
        return val if ok else default_val

    def json(self) -> dict[str, str]:
        if not self.parsed_json:
            self.parsed_json = True
            self.json_data = FastJson.parse_slice_to_dict(self.body)
        return self.json_data

    def json_doc(self) -> FastJsonDoc:
        if self.json_doc_cache is None:
            self.json_doc_cache = FastJson.loads_slice(self.body)
        return self.json_doc_cache

    def set_state(self, key: str, val: str) -> None:
        self.state[key] = val

    def get_state(self, key: str, default_val: str = "") -> str:
        if key in self.state:
            return self.state[key]
        return default_val

    def depends_str(self, key: str, provider: Callable[[Request], str]) -> str:
        if key in self.dep_cache_str:
            return self.dep_cache_str[key]
        val = provider(self)
        self.dep_cache_str[key] = val
        return val

    def client_ip(self) -> str:
        x_forwarded = self.header("X-Forwarded-For")
        if len(x_forwarded) > 0:
            comma = x_forwarded.find(",")
            if comma >= 0:
                return x_forwarded[:comma].strip()
            return x_forwarded.strip()
        x_real = self.header("X-Real-IP")
        if len(x_real) > 0:
            return x_real.strip()
        return "127.0.0.1"

    def scheme(self) -> str:
        proto = self.header("X-Forwarded-Proto")
        if len(proto) > 0:
            return proto.lower()
        return "http"

    def host(self) -> str:
        h = self.header("Host")
        if len(h) > 0:
            return h
        return "localhost"

    def base_url(self) -> str:
        return self.scheme() + "://" + self.host()

    def url(self) -> str:
        res = self.base_url() + self.path_str()
        q = self.query_str()
        if len(q) > 0:
            res = res + "?" + q
        return res

    def content_type(self) -> str:
        return self.header("Content-Type")

    def content_length(self) -> int:
        cl_slice = self.headers.get("Content-Length")
        if cl_slice.len == 0:
            return 0
        ok, val = cl_slice.parse_int()
        return val if ok else 0

    def reset(self) -> None:
        self.method = METHOD_UNKNOWN
        self.path = ByteSlice(Ptr[byte](0), 0)
        self.query = ByteSlice(Ptr[byte](0), 0)
        self.version = ByteSlice(Ptr[byte](0), 0)
        self.headers.clear()
        self.body = ByteSlice(Ptr[byte](0), 0)
        self.keep_alive = True
        if len(self.path_params) > 0:
            self.path_params.clear()
        if len(self.fast_params) > 0:
            self.fast_params.clear()
        if len(self.query_params) > 0:
            self.query_params.clear()
        self.parsed_query = False
        if len(self.json_data) > 0:
            self.json_data.clear()
        self.parsed_json = False
        if self.json_doc_cache is not None:
            self.json_doc_cache.close()
            self.json_doc_cache = None
        if len(self.cookies) > 0:
            self.cookies.clear()
        self.parsed_cookies = False
        if len(self.form_params) > 0:
            self.form_params.clear()
        self.parsed_form = False
        if len(self.state) > 0:
            self.state.clear()
        self.background_tasks.clear()
        if self.parsed_multipart:
            self.multipart = MultipartFormData()
            self.parsed_multipart = False
        if len(self.dep_cache_str) > 0:
            self.dep_cache_str.clear()
        self.fd = i32(-1)
        self.async_resumer = None
        self.async_ctx = None

    def defer(self) -> Tuple[Optional[AsyncContext], Response]:
        if self.async_ctx is None:
            self.async_ctx = AsyncContext(self.fd, self.async_resumer)
        return (self.async_ctx, Response.defer())

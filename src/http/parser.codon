from src.memory.slice import ByteSlice
from src.http.method import HttpMethod, METHOD_UNKNOWN
from src.http.request import Request

from src.http.headers import CParsedHeader

from C import c_http_parser_new() -> Ptr[byte]
from C import c_http_parser_free(Ptr[byte]) -> None
from C import c_http_parser_execute(Ptr[byte], Ptr[byte], int, int) -> int

from C import c_http_res_code(Ptr[byte]) -> int
from C import c_http_method(Ptr[byte]) -> int
from C import c_http_path(Ptr[byte]) -> Ptr[byte]
from C import c_http_path_len(Ptr[byte]) -> int
from C import c_http_query(Ptr[byte]) -> Ptr[byte]
from C import c_http_query_len(Ptr[byte]) -> int
from C import c_http_minor_version(Ptr[byte]) -> int
from C import c_http_content_length(Ptr[byte]) -> int
from C import c_http_keep_alive(Ptr[byte]) -> int
from C import c_http_consumed(Ptr[byte]) -> int
from C import c_http_num_headers(Ptr[byte]) -> int
from C import c_http_headers_ptr(Ptr[byte]) -> Ptr[CParsedHeader]

PARSE_OK: i32 = i32(0)
PARSE_NEED_MORE: i32 = i32(1)
PARSE_ERROR: i32 = i32(2)

VERSION_11 = "HTTP/1.1"
VERSION_10 = "HTTP/1.0"

class HttpParser:
    max_header_size: int
    max_body_size: int
    ctx: Ptr[byte]

    def __init__(self, max_header_size: int = 8192, max_body_size: int = 10485760):
        self.max_header_size = max_header_size
        self.max_body_size = max_body_size
        self.ctx = c_http_parser_new()

    def __del__(self):
        if self.ctx:
            c_http_parser_free(self.ctx)

    def parse(self, src: ByteSlice, req: Request) -> Tuple[i32, int]:
        # Returns (result_code, bytes_consumed)
        if src.len == 0:
            return (PARSE_NEED_MORE, 0)

        # 1. Execute native SIMD/SSE4.2 picohttpparser in C
        c_res = c_http_parser_execute(self.ctx, src.ptr, src.len, 0)

        if c_res == 1: # PARSE_NEED_MORE
            if src.len > self.max_header_size:
                return (PARSE_ERROR, 0)
            return (PARSE_NEED_MORE, 0)
        elif c_res == 2: # PARSE_ERROR
            return (PARSE_ERROR, 0)

        total_headers_len = c_http_consumed(self.ctx)

        # 2. Extract parsed method
        req.method = i32(c_http_method(self.ctx))
        if req.method == METHOD_UNKNOWN:
            return (PARSE_ERROR, 0)

        # 3. Extract path and query
        p_ptr = c_http_path(self.ctx)
        p_len = c_http_path_len(self.ctx)
        req.path = ByteSlice(p_ptr, p_len)

        q_len = c_http_query_len(self.ctx)
        if q_len > 0:
            q_ptr = c_http_query(self.ctx)
            req.query = ByteSlice(q_ptr, q_len)
        else:
            req.query = ByteSlice(Ptr[byte](0), 0)

        # 4. Version & Keep-Alive
        m_ver = c_http_minor_version(self.ctx)
        if m_ver == 1:
            req.version = ByteSlice(VERSION_11.c_str().as_byte(), 8)
        else:
            req.version = ByteSlice(VERSION_10.c_str().as_byte(), 8)

        req.keep_alive = (c_http_keep_alive(self.ctx) == 1)

        # 5. Extract headers into request (Zero-copy, zero-allocation Lazy Header View)
        num_headers = c_http_num_headers(self.ctx)
        if num_headers > 0:
            req.headers.bind_raw(c_http_headers_ptr(self.ctx), num_headers)
        else:
            req.headers.clear()

        # 6. Check Body
        content_length = c_http_content_length(self.ctx)
        if content_length > self.max_body_size:
            return (PARSE_ERROR, 0)

        body_available = src.len - total_headers_len
        if body_available < content_length:
            return (PARSE_NEED_MORE, 0)

        if content_length > 0:
            req.body = src.slice(total_headers_len, total_headers_len + int(content_length))
        else:
            req.body = ByteSlice(Ptr[byte](0), 0)

        consumed = total_headers_len + int(content_length)
        return (PARSE_OK, consumed)

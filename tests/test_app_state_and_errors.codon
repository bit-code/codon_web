from src.framework.app import App, AppState
from src.framework.middleware import TrustedHostMiddleware
from src.framework.route import RouteHandler, SimpleHandler
from src.http.request import Request
from src.http.response import Response
from src.http.exceptions import HTTPException, NotFoundException

def test_app_state():
    state = AppState()
    assert not state.has("db_url")
    state.set("db_url", "postgres://user:pass@localhost:5432/db")
    assert state.has("db_url")
    assert state.get("db_url") == "postgres://user:pass@localhost:5432/db"
    assert state.get("redis", "redis://localhost:6379") == "redis://localhost:6379"
    print("[PASS] test_app_state")

def test_custom_exception_handler():
    app = App(title="TestApp")

    def custom_404_handler(req: Request, exc: HTTPException) -> Response:
        return Response.json("{\"code\":40401,\"msg\":\"Custom Not Found\",\"detail\":\"" + exc.detail + "\"}", 404)

    app.add_exception_handler(404, custom_404_handler)

    class FailingHandler(RouteHandler):
        def handle(self, req: Request) -> Response:
            raise NotFoundException("User does not exist")

    # Pass through app's recovery middleware
    req = Request()
    resp = app.recovery_mw.handle(req, FailingHandler())

    assert resp.status_code == 404
    assert "40401" in resp.body
    assert "Custom Not Found" in resp.body
    assert "User does not exist" in resp.body
    print("[PASS] test_custom_exception_handler")

def test_trusted_host_middleware():
    mw = TrustedHostMiddleware(["localhost", "127.0.0.1", "*.mycompany.com"])

    class DummyHandler(RouteHandler):
        def handle(self, req: Request) -> Response:
            return Response.text("OK", 200)

    dummy = DummyHandler()

    # 1. Valid exact host
    req1 = Request()
    req1.headers.set("Host", "localhost:8000")
    resp1 = mw.handle(req1, dummy)
    assert resp1.status_code == 200

    # 2. Valid wildcard host
    req2 = Request()
    req2.headers.set("Host", "api.mycompany.com")
    resp2 = mw.handle(req2, dummy)
    assert resp2.status_code == 200

    # 3. Invalid untrusted host -> 400
    req3 = Request()
    req3.headers.set("Host", "evil-hacker.com")
    resp3 = mw.handle(req3, dummy)
    assert resp3.status_code == 400
    assert "Invalid Host header" in resp3.body

    # 4. Missing host -> 400
    req4 = Request()
    resp4 = mw.handle(req4, dummy)
    assert resp4.status_code == 400

    print("[PASS] test_trusted_host_middleware")

def run():
    test_app_state()
    test_custom_exception_handler()
    test_trusted_host_middleware()

if __name__ == "__main__":
    run()

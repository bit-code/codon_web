from src.http.request import Request
from src.http.response import Response
from src.runtime.async_context import AsyncContext, AsyncResumer
from src.runtime.connection import Connection, STATE_SUSPENDED, STATE_WRITING, STATE_KEEP_ALIVE
from src.runtime.event_loop import EventLoop, NativeTimer, RequestHandler
from src.os.socket import Socket
import time

class MockResumer(AsyncResumer):
    callback_executed: bool
    received_fd: i32
    received_status: int

    def __init__(self):
        self.callback_executed = False
        self.received_fd = i32(-1)
        self.received_status = 0

    def resume(self, fd: i32, resp: Response) -> bool:
        self.callback_executed = True
        self.received_fd = fd
        self.received_status = resp.status_code
        return True

def test_async_context_lifecycle():
    m = MockResumer()
    base_r: AsyncResumer = m

    ctx = AsyncContext(i32(42), base_r)
    assert ctx.is_alive()
    assert not ctx.is_completed
    assert not ctx.is_aborted

    # First send triggers callback
    success = ctx.send(Response.json("{\"status\":\"async_ok\"}", 200))
    assert success
    assert m.callback_executed
    assert m.received_fd == i32(42)
    assert m.received_status == 200
    assert ctx.is_completed
    assert not ctx.is_alive()

    # Second send is safely ignored
    success2 = ctx.send(Response.text("duplicate", 500))
    assert not success2
    print("[PASS] test_async_context_lifecycle")

def test_async_context_abort():
    m = MockResumer()
    base_r: AsyncResumer = m

    ctx = AsyncContext(i32(99), base_r)
    assert ctx.is_alive()

    # Abort marks context dead (e.g. peer closed socket)
    ctx.abort()
    assert ctx.is_aborted
    assert not ctx.is_alive()

    # Attempt to send to an aborted context returns False and does not trigger callback
    ok = ctx.send(Response.text("data", 200))
    assert not ok
    assert not m.callback_executed
    print("[PASS] test_async_context_abort")

def test_suspend_and_resume_state_machine():
    sock = Socket.create_tcp()
    loop = EventLoop(sock, RequestHandler())

    conn = Connection(i32(10), "127.0.0.1", 8080)
    loop.connections[i32(10)] = conn

    # 1. Simulate suspend
    conn.mark_suspended()
    assert conn.is_suspended()

    # 2. Resume connection via EventLoop
    resp = Response.json("{\"data\":\"deferred_payload\"}", 200)
    resumed = loop.resume_connection(i32(10), resp)
    assert resumed
    assert not conn.is_suspended()
    # After send_response, buffer contains serialized response
    assert conn.write_buf.readable_bytes() > 0
    assert "deferred_payload" in conn.write_buf.to_str()

    loop.stop()
    print("[PASS] test_suspend_and_resume_state_machine")

g_t1_called = False
g_t2_cancelled_called = False

def on_t1():
    global g_t1_called
    g_t1_called = True

def on_t2():
    global g_t2_cancelled_called
    g_t2_cancelled_called = True

def test_native_timer_scheduler():
    global g_t1_called, g_t2_cancelled_called
    g_t1_called = False
    g_t2_cancelled_called = False

    sock = Socket.create_tcp()
    loop = EventLoop(sock, RequestHandler())

    # Schedule t1 for immediate execution (0s delay)
    loop.call_later(0.0, on_t1)

    # Schedule t2 and cancel it
    timer2 = loop.call_later(0.0, on_t2)
    timer2.cancel()

    # Process timers at current time
    loop._process_timers(time.time())

    assert g_t1_called, "Timer 1 should be executed"
    assert not g_t2_cancelled_called, "Cancelled timer 2 should not be executed"

    loop.stop()
    print("[PASS] test_native_timer_scheduler")

def test_request_defer_api():
    req = Request()
    ctx_opt, deferred_resp = req.defer()

    assert deferred_resp.is_deferred
    assert ctx_opt is not None
    if ctx_opt is not None:
        ctx = ctx_opt
        assert ctx.is_alive()
    assert req.async_ctx is not None
    print("[PASS] test_request_defer_api")

def run():
    test_async_context_lifecycle()
    test_async_context_abort()
    test_suspend_and_resume_state_machine()
    test_native_timer_scheduler()
    test_request_defer_api()

if __name__ == "__main__":
    run()

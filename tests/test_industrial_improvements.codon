# Comprehensive Verification Test for Industrial-Grade Architecture Improvements
# Tests:
# 1. AsyncStreamWriter High-Water Mark Backpressure & drain() synchronization
# 2. EventLoop Suspended Async Request 504 Gateway Timeout & Cascade Cancellation
# 3. Native Structured Concurrency (gather2, gather3) and Sibling Task Cancellation on Failure
# 4. ServerConfig & POSIX Process Resilience Constants (WNOHANG, SIGTERM, SIGINT)

import time
from typing import Optional, Tuple
from src.http.request import Request
from src.http.response import Response
from src.runtime.async_context import AsyncContext, AsyncResumer
from src.framework.app import App
from src.memory.slice import ByteSlice
from src.http.method import METHOD_GET
from src.core.async.loop import get_event_loop, create_task, wait_for, gather2, gather3
from src.core.async.stream import AsyncStreamWriter
from src.os.socket import Socket
from src.os.constants import WNOHANG, SIGINT, SIGTERM, SIGKILL
from src.os.linux import recv as c_recv
from src.config.server import ServerConfig
from src.runtime.event_loop import EventLoop
from src.framework.router import RouterAdapter
from asyncio import sleep

print("=== Starting Test Suite: Industrial-Grade Architecture Improvements ===")
loop = get_event_loop()

# ----------------- Test 1: AsyncStreamWriter Backpressure & drain() -----------------
print("\n--- Test 1: AsyncStreamWriter Backpressure & drain() ---")
# Create a local TCP client socket pair
server_sock = Socket.create_tcp()
server_sock.set_reuse_addr(True)
server_sock.bind("127.0.0.1", 19890)
server_sock.listen(1)

client_sock = Socket.create_tcp_client(blocking=False)
client_sock.connect("127.0.0.1", 19890)

accepted_fd, client_ip, client_port = server_sock.accept_nonblocking()
while accepted_fd < i32(0):
    time.sleep(0.005)
    accepted_fd, client_ip, client_port = server_sock.accept_nonblocking()

server_conn_sock = Socket(accepted_fd)
Socket.set_fd_tcp_nodelay(client_sock.fd, True)
Socket.set_fd_tcp_nodelay(server_conn_sock.fd, True)

# Set tiny watermarks for explicit testing: high=100 bytes, low=20 bytes
writer = AsyncStreamWriter(
    client_sock,
    loop=loop,
    high_water_mark=100,
    low_water_mark=20
)

assert not writer.is_paused(), "Writer must start unpaused"
assert writer.get_buffer_size() == 0, "Buffer starts empty"

async def run_backpressure_test():
    total_written = [0]
    # Keep writing until TCP send buffer fills up and write buffer triggers backpressure
    while not writer.is_paused() and total_written[0] < 20000000:
        chunk = "X" * 65536
        writer.write_buffer(chunk)
        total_written[0] += len(chunk)

    # Verify that backpressure paused state was triggered
    assert writer.get_buffer_size() > 0, "Unsent bytes must be queued in write buffer"
    assert writer.is_paused(), "Writer must enter paused state when buffer exceeds high_water_mark"
    print("[PASS] Test 1.1: Backpressure paused state triggered when buffer exceeded high_water_mark (" + str(writer.get_buffer_size()) + " bytes queued, total sent=" + str(total_written[0]) + ")")

    # Concurrently read from receiving end so socket drain can progress
    drained_bytes = [0]
    async def drain_receiver():
        raw_buf = Ptr[byte](65536)
        while drained_bytes[0] < total_written[0]:
            n = c_recv(server_conn_sock.fd, raw_buf, 65536, i32(0))
            if n > 0:
                drained_bytes[0] += n
            elif n < 0:
                await sleep(0.002)

    recv_task = loop.create_task(drain_receiver())

    # Now await drain()
    await writer.drain()

    assert not writer.is_paused(), "Writer must be unpaused after drain"
    assert writer.get_buffer_size() <= 20, "Buffer size must drop below low_water_mark after drain"
    print("[PASS] Test 1.2: Writer buffer successfully drained and unpaused via drain()!")

    await recv_task
    assert drained_bytes[0] == total_written[0], "All written bytes received across stream"
    print("[PASS] Test 1.3: All data verified across stream transport!")

bp_task = loop.create_task(run_backpressure_test())
loop.run_until_complete(bp_task)

writer.close()
server_conn_sock.close()
server_sock.close()

# ----------------- Test 2: Native Structured Concurrency (gather2, gather3) -----------------
print("\n--- Test 2: Structured Concurrency (gather2 & gather3) ---")

async def fetch_data_1():
    await sleep(0.01)
    return "alpha"

async def fetch_data_2():
    await sleep(0.01)
    return 42

async def fetch_data_3():
    await sleep(0.01)
    return "gamma"

sibling_cancelled = [False]
async def slow_sibling():
    try:
        await sleep(0.2)
        return "slow_done"
    except:
        sibling_cancelled[0] = True
        raise

async def failing_task():
    await sleep(0.005)
    raise ValueError("Intentional task failure")

async def run_gather_tests():
    # 2.1 Test gather2 success
    t_start = time.time()
    r1, r2 = await gather2(fetch_data_1(), fetch_data_2())
    t_dur = time.time() - t_start
    assert r1 == "alpha"
    assert r2 == 42
    # Because they ran concurrently, duration is ~0.01s not 0.02s
    assert t_dur < 0.15, "Concurrent execution duration must be close to single task sleep"
    print("[PASS] Test 2.1: gather2 successfully executed concurrent tasks in " + str(int(t_dur * 1000.0)) + "ms")

    # 2.2 Test gather3 success
    g1, g2, g3 = await gather3(fetch_data_1(), fetch_data_2(), fetch_data_3())
    assert g1 == "alpha" and g2 == 42 and g3 == "gamma"
    print("[PASS] Test 2.2: gather3 successfully returned typed 3-tuple results")

    # 2.3 Test sibling task cancellation upon failure
    caught = False
    try:
        await gather2(failing_task(), slow_sibling())
    except ValueError as e:
        caught = True
        assert "Intentional task failure" in str(e)

    assert caught, "Exception must propagate out of gather2"
    # Wait for cancellation to settle
    await sleep(0.02)
    assert sibling_cancelled[0], "Sibling task must be automatically cancelled when sibling fails"
    print("[PASS] Test 2.3: Sibling task cancellation cleanly propagated in structured concurrency!")

gather_test_task = loop.create_task(run_gather_tests())
loop.run_until_complete(gather_test_task)

# ----------------- Test 3: EventLoop Suspended Async Request 504 Timeout & Cleanup -----------------
print("\n--- Test 3: Suspended Async Request 504 Timeout & Cleanup ---")

class TimeoutMockResumer(AsyncResumer):
    resumed_fd: i32
    received_status: int
    received_body: str
    call_count: int

    def __init__(self):
        self.resumed_fd = i32(-1)
        self.received_status = 0
        self.received_body = ""
        self.call_count = 0

    def resume(self, fd: i32, resp: Response) -> bool:
        self.resumed_fd = fd
        self.received_status = resp.status_code
        self.received_body = resp.body
        self.call_count += 1
        return True

hang_cancelled = [False]
timeout_app = App()

@timeout_app.async_get("/api/hang-forever")
async def hang_forever_handler(req: Request):
    try:
        await sleep(10.0)
        return Response.text("should_not_reach_here", 200)
    except:
        hang_cancelled[0] = True
        raise

# Simulate request
hang_resumer = TimeoutMockResumer()
base_hr: AsyncResumer = hang_resumer

req_hang = Request()
req_hang.method = METHOD_GET
req_hang.fd = i32(777)
req_hang.async_resumer = base_hr
p_hang = "/api/hang-forever"
req_hang.path = ByteSlice(p_hang.c_str(), len(p_hang))

deferred_hang = timeout_app.router.dispatch(req_hang)
assert deferred_hang.is_deferred
assert not hang_cancelled[0]

# Setup mock EventLoop with short async_timeout_sec = 0.05s
dummy_listen = Socket.create_tcp()
adapter = RouterAdapter(timeout_app.router.radix)
el = EventLoop(
    listen_socket=dummy_listen,
    handler=adapter,
    async_timeout_sec=0.05
)

# Register the suspended context into EventLoop
assert req_hang.async_ctx is not None
ctx_h = req_hang.async_ctx
el.async_contexts[i32(777)] = ctx_h

# Wait for 0.07s so that async_timeout is exceeded
time.sleep(0.07)
now = time.time()
el.reap_idle_connections(now)

# Advance loop to allow coroutine cancellation to process
loop.run_one_iteration(5)
loop.run_one_iteration(5)

assert hang_cancelled[0], "Task should have received cascade cancellation upon 504 timeout"
assert i32(777) not in el.async_contexts, "Timed out context must be removed from async_contexts"
print("[PASS] Test 3: Suspended async request timed out, cascaded task cancellation, and cleaned up!")

dummy_listen.close()

# ----------------- Test 4: ServerConfig & POSIX Process Resilience Constants -----------------
print("\n--- Test 4: ServerConfig & POSIX Process Resilience Constants ---")
cfg = ServerConfig(async_timeout_ms=45000)
assert cfg.async_timeout_ms == 45000, "async_timeout_ms must be configurable in ServerConfig"

# Verify POSIX constants
assert WNOHANG == i32(1)
assert SIGINT == i32(2)
assert SIGKILL == i32(9)
assert SIGTERM == i32(15)
print("[PASS] Test 4: Process supervisor configuration & POSIX constants verified successfully!")

print("\n=========================================================================")
print(">>> ALL INDUSTRIAL-GRADE ARCHITECTURE IMPROVEMENT TESTS PASSED CLEANLY! <<<")
print("=========================================================================")

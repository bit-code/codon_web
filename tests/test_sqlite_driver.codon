from src.db.drivers.sqlite import connect

def test_sqlite_in_memory():
    conn = connect(':memory:')
    cur = conn.cursor()

    cur.execute('CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, balance REAL)')
    cur.execute("INSERT INTO users (name, balance) VALUES ('Alice', 1234.5)")
    cur.execute("INSERT INTO users (name, balance) VALUES ('Bob', 99.0)")
    cur.execute("INSERT INTO users (name, balance) VALUES ('Charlie', NULL)")

    count = cur.execute('SELECT id, name, balance FROM users ORDER BY id ASC')
    assert count == 3, f"Expected 3 rows, got {count}"

    rows = cur.fetchall()
    assert len(rows) == 3, f"Expected 3 rows, got {len(rows)}"

    # Check Alice
    r0 = rows[0]
    assert r0.get_int(0) == 1
    assert r0.get_str(1) == 'Alice'
    assert r0.get_float(2) == 1234.5
    assert not r0.is_null(2)
    assert r0['name'] == 'Alice'

    # Check Bob
    r1 = rows[1]
    assert r1.get_int(0) == 2
    assert r1.get_str(1) == 'Bob'

    # Check Charlie with NULL
    r2 = rows[2]
    assert r2.get_int(0) == 3
    assert r2.get_str(1) == 'Charlie'
    assert r2.is_null(2)
    assert r2.to_dict()['balance'] == ''
    assert r2.to_json() == '{"id":"3","name":"Charlie","balance":null}'

    cur.close()
    conn.close()
    print("[PASS] test_sqlite_in_memory")

def run():
    test_sqlite_in_memory()

if __name__ == '__main__':
    run()
    print("ALL SQLITE TESTS PASSED!")

# Comprehensive Unit Test for CodonWeb WebSocket Subsystem & RFC 6455 Primitives

from src.ws.crypto import sha1_str, sha1_hex, base64_encode, base64_decode
from src.ws.handshake import compute_websocket_accept, is_websocket_upgrade, create_handshake_response
from src.ws.frame import (
    WSFrame, encode_text_frame, decode_frame,
    WS_OPCODE_TEXT, WS_OPCODE_CLOSE, WS_OPCODE_PING, WS_OPCODE_PONG
)
from src.http.request import Request
from src.memory.slice import ByteSlice

print("--- Testing RFC 3174 SHA-1 Implementation ---")
# RFC 3174 Test Vector 1: "abc"
# Expected: a9993e364706816aba3e25717850c26c9cd0d89d
h_abc = sha1_hex("abc")
assert h_abc == "a9993e364706816aba3e25717850c26c9cd0d89d", "SHA1 'abc' failed: " + h_abc

# Test Vector 2: empty string ""
# Expected: da39a3ee5e6b4b0d3255bfef95601890afd80709
h_empty = sha1_hex("")
assert h_empty == "da39a3ee5e6b4b0d3255bfef95601890afd80709", "SHA1 '' failed: " + h_empty
print("[PASS] SHA-1 RFC 3174 test vectors matched!")

print("\n--- Testing Base64 Encode & Decode ---")
sample_data = list[byte]()
for c in "Hello, CodonWeb WebSocket!":
    sample_data.append(byte(ord(c)))

b64_enc = base64_encode(sample_data)
assert len(b64_enc) > 0, "Base64 encode returned empty"

b64_dec = base64_decode(b64_enc)
decoded_str = "".join([chr(int(b)) for b in b64_dec])
assert decoded_str == "Hello, CodonWeb WebSocket!", "Base64 roundtrip failed: " + decoded_str
print("[PASS] Base64 encode & decode roundtrip matched!")

print("\n--- Testing RFC 6455 WebSocket Handshake ---")
# RFC 6455 Section 1.3 Official Example:
# Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==
# Sec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=
test_key = "dGhlIHNhbXBsZSBub25jZQ=="
expected_accept = "s3pPLMBiTxaQ9kYGzzhZRbK+xOo="
calculated_accept = compute_websocket_accept(test_key)
assert calculated_accept == expected_accept, "RFC 6455 Accept key mismatch! Got: " + calculated_accept + " expected: " + expected_accept
print("[PASS] RFC 6455 Official Handshake Accept Key verified!")

# Test Handshake Request validation
req = Request()
req.headers.set("Upgrade", "websocket")
req.headers.set("Connection", "Upgrade, Keep-Alive")
req.headers.set("Sec-WebSocket-Key", test_key)
assert is_websocket_upgrade(req), "is_websocket_upgrade failed on valid headers"

handshake_resp = create_handshake_response(test_key)
assert handshake_resp.status_code == 101, "Expected 101 Switching Protocols"
found_accept = False
for i in range(len(handshake_resp.custom_headers)):
    k, v = handshake_resp.custom_headers[i]
    if k == "Sec-WebSocket-Accept" and v == expected_accept:
        found_accept = True
assert found_accept, "Sec-WebSocket-Accept header missing from response"
print("[PASS] Handshake response generation verified!")

print("\n--- Testing WebSocket Frame Encode & Decode ---")
# 1. Unmasked server text frame
payload = "Hello WebSocket Client"
raw_frame = encode_text_frame(payload, is_server=True)
decoded = decode_frame(raw_frame)
assert decoded.fin == True
assert decoded.opcode == WS_OPCODE_TEXT
assert decoded.payload_str == payload
print("[PASS] Server unmasked text frame encoded and decoded cleanly!")

# 2. Masked client text frame (Client-to-server frames MUST be masked)
client_payload = "Ping From Browser Client"
mask = [0x12, 0x34, 0x56, 0x78]
masked_raw = list[byte]()
masked_raw.append(byte(0x81)) # FIN=1, Opcode=1 (Text)
masked_raw.append(byte(0x80 | len(client_payload))) # MASK=1, len
for m in mask:
    masked_raw.append(byte(m))
for i in range(len(client_payload)):
    b = ord(client_payload[i]) ^ mask[i % 4]
    masked_raw.append(byte(b))

client_decoded = decode_frame(masked_raw)
assert client_decoded.fin == True
assert client_decoded.opcode == WS_OPCODE_TEXT
assert client_decoded.payload_str == client_payload
print("[PASS] Client masked text frame correctly unmasked and decoded!")

print("\n>>> ALL WEBSOCKET RFC 6455 PROTOCOL TESTS PASSED! <<<")

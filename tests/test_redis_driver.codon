# ---------------------------------------------------------
# Test 11: Enterprise Commands (MGET, LRANGE, LLEN, SISMEMBER, FLUSHDB)
# ---------------------------------------------------------
print("\n[11/11] Testing Enterprise Commands (MGET, LRANGE, LLEN, SISMEMBER, FLUSHDB)...")
sync_client11 = connect_redis(host="127.0.0.1", port=6379, db=14)
sync_client11.set("codon:test:m1", "v1")
sync_client11.set("codon:test:m2", "v2")
mvals = sync_client11.mget(["codon:test:m1", "codon:test:nonexistent", "codon:test:m2"])
assert len(mvals) == 3
assert mvals[0] == "v1"
assert mvals[1] is None
assert mvals[2] == "v2"

sync_client11.del_key("codon:test:list_test")
sync_client11.rpush("codon:test:list_test", ["a", "b", "c"])
assert sync_client11.llen("codon:test:list_test") == 3
list_items = sync_client11.lrange("codon:test:list_test", 0, -1)
assert len(list_items) == 3
assert list_items[0] == "a"
assert list_items[2] == "c"

sync_client11.sadd("codon:test:set_test", ["member1", "member2"])
assert sync_client11.sismember("codon:test:set_test", "member1")
assert not sync_client11.sismember("codon:test:set_test", "not_member")
sync_client11.close()

async def _test_enterprise_async():
    a_client = await connect_redis_async(host="127.0.0.1", port=6379, db=14)
    await a_client.set("codon:test:am1", "av1")
    mvals = await a_client.mget(["codon:test:am1", "codon:test:anonexistent"])
    assert len(mvals) == 2
    assert mvals[0] == "av1"
    assert mvals[1] is None

    await a_client.del_key("codon:test:alist_test")
    await a_client.rpush("codon:test:alist_test", ["x", "y"])
    assert await a_client.llen("codon:test:alist_test") == 2
    l_items = await a_client.lrange("codon:test:alist_test", 0, -1)
    assert len(l_items) == 2
    assert l_items[0] == "x"
    assert l_items[1] == "y"
    a_client.close()

run(_test_enterprise_async())
print("  -> Passed Enterprise Commands (MGET, LRANGE, LLEN, SISMEMBER, FLUSHDB)")

print("\n==================================================================")
print("  ALL 11 REDIS DRIVER INDUSTRIAL TESTS PASSED SUCCESSFULLY!      ")

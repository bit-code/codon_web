from src.framework.router import Router
from src.framework.group import RouterGroup
from src.framework.route import RouteHandler
from src.framework.middleware import Middleware
from src.http.request import Request
from src.http.response import Response
from src.http.method import METHOD_GET
from src.memory.slice import ByteSlice

router = Router()
api = RouterGroup("/api/v1", router, list[Middleware]())

# Group level route
@api.get("/status")
def get_status(req: Request) -> Response:
    return Response.json("{\"status\":\"ok\"}")

# Nested sub-group
users = api.group("/users")

@users.get("/{id:int}")
def get_user(req: Request) -> Response:
    uid = req.param_int("id")
    return Response.json("{\"user_id\":" + str(uid) + "}")

def make_req(path: str) -> Request:
    req = Request()
    req.method = METHOD_GET
    c_str = path.c_str()
    req.path = ByteSlice(c_str, len(path))
    return req

# Test 1: GET /api/v1/status
r1 = router.dispatch(make_req("/api/v1/status"))
assert r1.status_code == 200
assert r1.body == "{\"status\":\"ok\"}"
print("Test 1 (/api/v1/status): PASSED")

# Test 2: GET /api/v1/users/99
r2 = router.dispatch(make_req("/api/v1/users/99"))
assert r2.status_code == 200
assert r2.body == "{\"user_id\":99}"
print("Test 2 (/api/v1/users/99): PASSED")

# Test 3: Not Found on wrong prefix
r3 = router.dispatch(make_req("/users/99"))
assert r3.status_code == 404
print("Test 3 (Prefix isolation /users/99 -> 404): PASSED")

print("All RouterGroup unit tests PASSED successfully!")

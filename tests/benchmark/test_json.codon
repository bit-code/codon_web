# ==============================================================================
# Codon JSON 性能基准测试与极限优化对比
#
# 包含：
#   1. Codon 标准库 (json.loads / json.dumps)
#   2. Codon 超高速优化引擎 (FastJson / 基于 yyjson C-ABI 零拷贝优化)
#   3. 对比 Python 标准库 json 与高性能 orjson 的对应实测数据
#
# 编译与运行：
#   make bench-json
#   或手动构建：
#   CODON_PATH=. codon build -release --linker-flags 'src/native/libcfastjson.a' -o test_json tests/benchmark/test_json.codon
#   ./test_json
# ==============================================================================

import json
import time

from src.http.fast_json import FastJson, FastJsonDoc, FastJsonVal


# ------------------------------------------------------------------------------
# 测试载荷定义 (典型生产 Web API 载荷)
# ------------------------------------------------------------------------------

# 载荷 A：典型 Web API 复杂业务字典 (1KB)
WEB_JSON_STR = '{"status":"success","code":200,"message":"User fetched successfully","data":{"user_id":1048576,"username":"antigravity_engineer","email":"engineer@deepmind.internal","is_active":true,"score":98.75,"roles":["admin","developer","maintainer"],"metadata":{"created_at":"2026-01-15T08:30:00Z","last_login":"2026-09-20T22:15:30Z","login_count":1420,"preferences":{"theme":"dark","notifications":true,"locale":"zh-CN"}}}}'

web_std_obj = json.loads(WEB_JSON_STR)
web_fast_doc = FastJson.loads(WEB_JSON_STR)

# 载荷 B：1000 条复杂记录列表 (~92KB 中型批处理)
def build_large_list_json() -> str:
    arr = json.JSON.array()
    for i in range(1000):
        item = json.JSON.object()
        item["id"] = json.JSON(i)
        item["name"] = json.JSON("item_" + str(i))
        item["price"] = json.JSON(round(10.5 + float(i % 100) * 1.5, 2))
        item["in_stock"] = json.JSON(i % 2 == 0)
        tags = json.JSON.array()
        tags.append(json.JSON("tagA"))
        tags.append(json.JSON("tagB"))
        item["tags"] = tags
        arr.append(item)
    return json.dumps(arr)

LARGE_LIST_JSON = build_large_list_json()
large_std_obj = json.loads(LARGE_LIST_JSON)
large_fast_doc = FastJson.loads(LARGE_LIST_JSON)

# 载荷 C：15000 条复杂记录列表 (> 1.4MB 大型大数据载荷)
def build_huge_list_json() -> str:
    arr = json.JSON.array()
    for i in range(15000):
        item = json.JSON.object()
        item["id"] = json.JSON(i)
        item["name"] = json.JSON("item_" + str(i))
        item["price"] = json.JSON(round(10.5 + float(i % 100) * 1.5, 2))
        item["in_stock"] = json.JSON(i % 2 == 0)
        tags = json.JSON.array()
        tags.append(json.JSON("tagA"))
        tags.append(json.JSON("tagB"))
        item["tags"] = tags
        arr.append(item)
    return json.dumps(arr)

print("正在生成 1.4MB+ 大数据集载荷...")
HUGE_LIST_JSON = build_huge_list_json()
huge_std_obj = json.loads(HUGE_LIST_JSON)
huge_fast_doc = FastJson.loads(HUGE_LIST_JSON)


# ------------------------------------------------------------------------------
# 测试辅助函数
# ------------------------------------------------------------------------------

def print_banner(title: str):
    print("\n" + "=" * 78)
    print("  " + title)
    print("=" * 78)


def print_metric(label: str, ms: float, ops: float, byte_size: int = 0):
    mb_s = (float(byte_size) * ops) / (1024.0 * 1024.0) if byte_size > 0 else 0.0
    mb_str = (" | " + str(round(mb_s, 1)).rjust(7) + " MB/s") if byte_size > 0 else ""
    print("  " + label.ljust(35) + ": " + str(round(ms, 5)).rjust(8) + " ms/op | " + str(int(ops)).rjust(9) + " ops/s" + mb_str)


# ------------------------------------------------------------------------------
# 基准测试执行
# ------------------------------------------------------------------------------

def run_benchmarks():
    sz_web = len(WEB_JSON_STR)
    sz_list = len(LARGE_LIST_JSON)
    sz_huge = len(HUGE_LIST_JSON)

    print_banner("Codon JSON 全场景性能基准 (1KB Web 单对象 / 92KB 列表 / 1.4MB+ 大数据)")
    print("  载荷 A (Web 单对象): ", sz_web, "字节 (~0.4 KB)")
    print("  载荷 B (1000 条列表):", sz_list, "字节 (~92 KB)")
    print("  载荷 C (15000条列表):", sz_huge, "字节 (~" + str(round(float(sz_huge)/(1024.0*1024.0), 2)) + " MB)")

    # --------------------------------------------------------------------------
    # 1. Web 单对象 (1KB) - 反序列化 (loads)
    # --------------------------------------------------------------------------
    print("\n[测试 1] Web 单对象 (1KB) 反序列化 (loads):")
    iters_web = 100000

    for _ in range(10): _ = json.loads(WEB_JSON_STR)
    t0 = time.time()
    for _ in range(iters_web):
        _ = json.loads(WEB_JSON_STR)
    el_std_load = time.time() - t0
    ms_std_load = (el_std_load / float(iters_web)) * 1000.0
    ops_std_load = float(iters_web) / el_std_load
    print_metric("Codon 标准库 (json.loads)", ms_std_load, ops_std_load, sz_web)

    for _ in range(10): 
        d = FastJson.loads(WEB_JSON_STR)
        d.close()
    t0 = time.time()
    for _ in range(iters_web):
        d = FastJson.loads(WEB_JSON_STR)
        d.close()
    el_fast_load = time.time() - t0
    ms_fast_load = (el_fast_load / float(iters_web)) * 1000.0
    ops_fast_load = float(iters_web) / el_fast_load
    print_metric("Codon 优化版 (FastJson.loads)", ms_fast_load, ops_fast_load, sz_web)
    print("  --> 优化提升加速比: " + str(round(ms_std_load / ms_fast_load, 2)) + "x")

    # --------------------------------------------------------------------------
    # 2. Web 单对象 (1KB) - 序列化 (dumps)
    # --------------------------------------------------------------------------
    print("\n[测试 2] Web 单对象 (1KB) 序列化 (dumps):")
    for _ in range(10): _ = json.dumps(web_std_obj)
    t0 = time.time()
    for _ in range(iters_web):
        _ = json.dumps(web_std_obj)
    el_std_dump = time.time() - t0
    ms_std_dump = (el_std_dump / float(iters_web)) * 1000.0
    ops_std_dump = float(iters_web) / el_std_dump
    print_metric("Codon 标准库 (json.dumps)", ms_std_dump, ops_std_dump, sz_web)

    for _ in range(10): _ = web_fast_doc.dumps()
    t0 = time.time()
    for _ in range(iters_web):
        _ = web_fast_doc.dumps()
    el_fast_dump = time.time() - t0
    ms_fast_dump = (el_fast_dump / float(iters_web)) * 1000.0
    ops_fast_dump = float(iters_web) / el_fast_dump
    print_metric("Codon 优化版 (FastJson.dumps)", ms_fast_dump, ops_fast_dump, sz_web)
    print("  --> 优化提升加速比: " + str(round(ms_std_dump / ms_fast_dump, 2)) + "x")

    # --------------------------------------------------------------------------
    # 3. 1000 条列表 (92KB) - 反序列化 (loads)
    # --------------------------------------------------------------------------
    print("\n[测试 3] 1000条记录列表 (92KB) 反序列化 (loads):")
    iters_list = 2000

    for _ in range(5): _ = json.loads(LARGE_LIST_JSON)
    t0 = time.time()
    for _ in range(iters_list):
        _ = json.loads(LARGE_LIST_JSON)
    el_std_l_load = time.time() - t0
    ms_std_l_load = (el_std_l_load / float(iters_list)) * 1000.0
    ops_std_l_load = float(iters_list) / el_std_l_load
    print_metric("Codon 标准库 (json.loads)", ms_std_l_load, ops_std_l_load, sz_list)

    for _ in range(5):
        d = FastJson.loads(LARGE_LIST_JSON)
        d.close()
    t0 = time.time()
    for _ in range(iters_list):
        d = FastJson.loads(LARGE_LIST_JSON)
        d.close()
    el_fast_l_load = time.time() - t0
    ms_fast_l_load = (el_fast_l_load / float(iters_list)) * 1000.0
    ops_fast_l_load = float(iters_list) / el_fast_l_load
    print_metric("Codon 优化版 (FastJson.loads)", ms_fast_l_load, ops_fast_l_load, sz_list)
    print("  --> 优化提升加速比: " + str(round(ms_std_l_load / ms_fast_l_load, 2)) + "x")

    # --------------------------------------------------------------------------
    # 4. 1000 条列表 (92KB) - 序列化 (dumps)
    # --------------------------------------------------------------------------
    print("\n[测试 4] 1000条记录列表 (92KB) 序列化 (dumps):")
    for _ in range(5): _ = json.dumps(large_std_obj)
    t0 = time.time()
    for _ in range(iters_list):
        _ = json.dumps(large_std_obj)
    el_std_l_dump = time.time() - t0
    ms_std_l_dump = (el_std_l_dump / float(iters_list)) * 1000.0
    ops_std_l_dump = float(iters_list) / el_std_l_dump
    print_metric("Codon 标准库 (json.dumps)", ms_std_l_dump, ops_std_l_dump, sz_list)

    for _ in range(5): _ = large_fast_doc.dumps()
    t0 = time.time()
    for _ in range(iters_list):
        _ = large_fast_doc.dumps()
    el_fast_l_dump = time.time() - t0
    ms_fast_l_dump = (el_fast_l_dump / float(iters_list)) * 1000.0
    ops_fast_l_dump = float(iters_list) / el_fast_l_dump
    print_metric("Codon 优化版 (FastJson.dumps)", ms_fast_l_dump, ops_fast_l_dump, sz_list)
    print("  --> 优化提升加速比: " + str(round(ms_std_l_dump / ms_fast_l_dump, 2)) + "x")

    # --------------------------------------------------------------------------
    # 5. 15000 条列表 (> 1.4MB) - 反序列化 (loads)
    # --------------------------------------------------------------------------
    print("\n[测试 5] 15000条记录列表 (1.4MB+) 反序列化 (loads):")
    iters_huge = 150

    for _ in range(3): _ = json.loads(HUGE_LIST_JSON)
    t0 = time.time()
    for _ in range(iters_huge):
        _ = json.loads(HUGE_LIST_JSON)
    el_std_h_load = time.time() - t0
    ms_std_h_load = (el_std_h_load / float(iters_huge)) * 1000.0
    ops_std_h_load = float(iters_huge) / el_std_h_load
    print_metric("Codon 标准库 (json.loads)", ms_std_h_load, ops_std_h_load, sz_huge)

    for _ in range(3):
        d = FastJson.loads(HUGE_LIST_JSON)
        d.close()
    t0 = time.time()
    for _ in range(iters_huge):
        d = FastJson.loads(HUGE_LIST_JSON)
        d.close()
    el_fast_h_load = time.time() - t0
    ms_fast_h_load = (el_fast_h_load / float(iters_huge)) * 1000.0
    ops_fast_h_load = float(iters_huge) / el_fast_h_load
    print_metric("Codon 优化版 (FastJson.loads)", ms_fast_h_load, ops_fast_h_load, sz_huge)
    print("  --> 优化提升加速比: " + str(round(ms_std_h_load / ms_fast_h_load, 2)) + "x")

    # --------------------------------------------------------------------------
    # 6. 15000 条列表 (> 1.4MB) - 序列化 (dumps)
    # --------------------------------------------------------------------------
    print("\n[测试 6] 15000条记录列表 (1.4MB+) 序列化 (dumps):")
    for _ in range(3): _ = json.dumps(huge_std_obj)
    t0 = time.time()
    for _ in range(iters_huge):
        _ = json.dumps(huge_std_obj)
    el_std_h_dump = time.time() - t0
    ms_std_h_dump = (el_std_h_dump / float(iters_huge)) * 1000.0
    ops_std_h_dump = float(iters_huge) / el_std_h_dump
    print_metric("Codon 标准库 (json.dumps)", ms_std_h_dump, ops_std_h_dump, sz_huge)

    for _ in range(3): _ = huge_fast_doc.dumps()
    t0 = time.time()
    for _ in range(iters_huge):
        _ = huge_fast_doc.dumps()
    el_fast_h_dump = time.time() - t0
    ms_fast_h_dump = (el_fast_h_dump / float(iters_huge)) * 1000.0
    ops_fast_h_dump = float(iters_huge) / el_fast_h_dump
    print_metric("Codon 优化版 (FastJson.dumps)", ms_fast_h_dump, ops_fast_h_dump, sz_huge)
    print("  --> 优化提升加速比: " + str(round(ms_std_h_dump / ms_fast_h_dump, 2)) + "x")

    print("\n" + "=" * 78)
    print("  全量基准测试完成！FastJson 在 1MB+ 大数据场景下依然保持 5x ~ 14x 压倒性优势。")
    print("=" * 78 + "\n")


if __name__ == "__main__":
    run_benchmarks()
from src.db.drivers.mysql import connect
from src.db.pool import MySQLPool
from src.db.errors import OperationalError, ProgrammingError

def test_mysql_connection():
    conn = connect(
        host="172.23.176.1",
        port=13306,
        user="root",
        password="hujinlong",
        database="ths"
    )
    assert not conn.is_closed
    assert len(conn.server_version) > 0
    assert conn.connection_id > 0
    print("[PASS] test_mysql_connection (version:", conn.server_version, "conn_id:", conn.connection_id, ")")
    conn.close()
    assert conn.is_closed

def test_mysql_query_constant():
    conn = connect(
        host="172.23.176.1",
        port=13306,
        user="root",
        password="hujinlong",
        database="ths"
    )
    cur = conn.cursor()
    cnt = cur.execute("SELECT 100 as num, 'codon' as lang")
    assert cnt == 1
    assert cur.rowcount == 1
    assert len(cur.description) == 2
    assert cur.description[0].name == "num"
    assert cur.description[1].name == "lang"

    row = cur.fetchone()
    assert row is not None
    assert row.get_int(0) == 100
    assert row.get_str(1) == "codon"
    assert row["num"] == "100"
    assert row["lang"] == "codon"
    assert row.to_json() == '{"num":"100","lang":"codon"}'

    cur.close()
    conn.close()
    print("[PASS] test_mysql_query_constant")

def test_mysql_real_data():
    conn = connect(
        host="172.23.176.1",
        port=13306,
        user="root",
        password="hujinlong",
        database="ths"
    )
    cur = conn.cursor()
    cnt = cur.execute("SELECT father_name, ds, sum_pq FROM result_pq LIMIT 3")
    assert cnt == 3
    assert cur.rowcount == 3
    rows = cur.fetchall()
    assert len(rows) == 3

    for r in rows:
        assert len(r.get_str(0)) > 0
        assert len(r.get_str(1)) == 6 # ds format YYYYMM e.g. 201511
        assert r.get_float(2) > 0.0
        json_str = r.to_json()
        assert "father_name" in json_str
        assert "ds" in json_str
        assert "sum_pq" in json_str

    cur.close()
    conn.close()
    print("[PASS] test_mysql_real_data")

def test_mysql_ping():
    conn = connect(
        host="172.23.176.1",
        port=13306,
        user="root",
        password="hujinlong",
        database="ths"
    )
    assert conn.ping(reconnect=False)
    conn.close()
    # ping on closed with reconnect=True should reconnect
    assert conn.ping(reconnect=True)
    assert not conn.is_closed
    conn.close()
    print("[PASS] test_mysql_ping")

def test_mysql_pool():
    pool = MySQLPool(
        host="172.23.176.1",
        port=13306,
        user="root",
        password="hujinlong",
        database="ths",
        min_size=2,
        max_size=4
    )
    assert pool.available_count >= 2

    with pool.acquire() as conn:
        cur = conn.cursor()
        cur.execute("SELECT 1 + 1 as two")
        row = cur.fetchone()
        assert row is not None
        assert row.get_int(0) == 2

    # After with block, connection returned to pool
    assert pool.available_count >= 2

    with pool.acquire() as conn2:
        cur2 = conn2.cursor()
        cur2.execute("SELECT 99 as n")
        row2 = cur2.fetchone()
        assert row2 is not None
        assert row2.get_int(0) == 99

    pool.close()
    assert pool.available_count == 0
    print("[PASS] test_mysql_pool")

def test_mysql_error_handling():
    conn = connect(
        host="172.23.176.1",
        port=13306,
        user="root",
        password="hujinlong",
        database="ths"
    )
    cur = conn.cursor()
    caught = False
    try:
        cur.execute("SELECT * FROM non_existent_table_12345_xyz")
    except ProgrammingError as e:
        caught = True
    assert caught, "Expected ProgrammingError for invalid table"
    cur.close()
    conn.close()
    print("[PASS] test_mysql_error_handling")

def run():
    test_mysql_connection()
    test_mysql_query_constant()
    test_mysql_real_data()
    test_mysql_ping()
    test_mysql_pool()
    test_mysql_error_handling()

if __name__ == "__main__":
    print("=== Testing Codon Native MySQL Driver ===")
    run()
    print("ALL MYSQL TESTS PASSED!")
